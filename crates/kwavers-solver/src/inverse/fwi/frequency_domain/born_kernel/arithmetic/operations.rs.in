// Canonical operation bodies. The generator supplies each concrete Self type;
// no precision-changing conversion or expression reassociation occurs.

#[inline]
fn product(incident: Complex<Self>, green: Complex<Self>) -> Complex<Self> {
    Complex {
        re: incident.re * green.re - incident.im * green.im,
        im: incident.re * green.im + incident.im * green.re,
    }
}

#[inline]
fn weight_block<const K: usize>(values: &mut [Complex<Self>; K], weights: &[Self]) {
    let len = weights.len();
    assert!(len <= K, "Born block exceeds output capacity");
    let mut lane = 0;
    while lane < len {
        let (value, weight) = (values[lane], weights[lane]);
        values[lane] = Complex { re: value.re * weight, im: value.im * weight };
        lane += 1;
    }
}

#[inline]
fn accumulate_block(mut sum: Complex<Self>, values: &[Complex<Self>]) -> Complex<Self> {
    let len = values.len();
    let mut lane = 0;
    while lane < len {
        let value = values[lane];
        sum.re += value.re;
        sum.im += value.im;
        lane += 1;
    }
    sum
}

#[inline]
fn project_block<const K: usize, const ACCUMULATE: bool>(
    values: &[Complex<Self>; K], weights: &[Self], residual: Complex<Self>,
    output: &mut [Self; K],
) {
    let len = weights.len();
    assert!(len <= K, "Born block exceeds output capacity");
    let mut lane = 0;
    while lane < len {
        let (value, weight) = (values[lane], weights[lane]);
        let derivative = Complex { re: value.re * weight, im: value.im * weight };
        let projection = derivative.re * residual.re - (-derivative.im) * residual.im;
        if ACCUMULATE {
            output[lane] += projection;
        } else {
            output[lane] = projection;
        }
        lane += 1;
    }
}
