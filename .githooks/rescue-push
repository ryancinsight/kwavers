#!/usr/bin/env bash
# Classify and scan the one pre-push exception for a new rescue branch.

set -uo pipefail

repo_root="$1"
stack_root="$2"
scanner_ref="$3"
allowlist_ref="$4"
shift 4

# Any update, deletion, or multi-ref push belongs to the normal hook gate.
[ "$#" -eq 1 ] || exit 3
read -r local_ref local_sha remote_ref remote_sha extra <<<"$1"
[ -z "${extra:-}" ] || {
    echo "pre-push: BLOCKED -- malformed ref update" >&2
    exit 1
}
zero="0000000000000000000000000000000000000000"
case "$remote_ref" in
    refs/heads/rescue/*) ;;
    *) exit 3 ;;
esac
[ "$remote_sha" = "$zero" ] || exit 3
[ "$local_sha" != "$zero" ] || exit 3

# The destination names the durable rescue branch. Git may name its source as
# HEAD, another local branch, or a raw object ID; the supplied object ID is the
# source of truth for all of those refspec forms.
[[ "$local_sha" =~ ^[0-9a-fA-F]{40}$ ]] || {
    echo "pre-push: BLOCKED -- malformed rescue tip" >&2
    exit 1
}
git -C "$repo_root" cat-file -e "$local_sha^{commit}" 2>/dev/null || {
    echo "pre-push: BLOCKED -- rescue tip is unavailable" >&2
    exit 1
}
git -C "$repo_root" cat-file -e "$allowlist_ref^{commit}" 2>/dev/null || {
    echo "pre-push: BLOCKED -- trusted allowlist revision is unavailable" >&2
    exit 1
}
git -C "$stack_root" cat-file -e "$scanner_ref:scripts/atlas-secret-scan.py" 2>/dev/null || {
    echo "pre-push: BLOCKED -- trusted credential scanner is unavailable" >&2
    exit 1
}

python_bin="${PYTHON:-}"
if [ -z "$python_bin" ]; then
    for candidate in python3 python; do
        if command -v "$candidate" >/dev/null 2>&1 \
            && "$candidate" -c 'import sys' >/dev/null 2>&1; then
            python_bin="$candidate"
            break
        fi
    done
fi
[ -n "$python_bin" ] || {
    echo "pre-push: BLOCKED -- no Python interpreter for the credential scan" >&2
    exit 1
}

# One scanner process judges every commit the rescue introduces, each against
# its first parent: a credential added and then removed is still published. The
# base is the merge-base with the trusted default; none means an unrelated
# history, scanned whole.
base="$(git -C "$repo_root" merge-base "$allowlist_ref" "$local_sha" 2>/dev/null || true)"
args=(check --root "$repo_root" --rev "$local_sha" --allowlist-rev "$allowlist_ref")
[ -n "$base" ] && args+=(--base "$base")
scan_status=0
git -C "$stack_root" show "$scanner_ref:scripts/atlas-secret-scan.py" \
    | "$python_bin" -I - "${args[@]}" || scan_status=$?
case "$scan_status" in
    0) exit 0 ;;
    1) exit 1 ;;
    *)
        echo "pre-push: BLOCKED -- the secret scan could not run (exit $scan_status), so the rescue was not scanned; the reason is the secret-scan line above." >&2
        exit 1
        ;;
esac
