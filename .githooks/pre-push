#!/usr/bin/env bash
#
# Atlas member-side pre-push gate (single owned copy; see below).
#
# Guards, in order: the lockfile must resolve under `--locked`; the pushed
# range must stay within the artifact budgets, add no credential, and raise no
# debt class above the member's recorded baseline; shared artifacts must match
# their source identity; and the packages the push changes must pass fmt, clippy,
# tests, and documentation. CI confirms what this found; it should not be where a
# defect is discovered.
#
# Refuse a push whose Cargo.lock cannot resolve under `--locked`.
#
# A member is normally worked on inside the Atlas stack, whose
# `.cargo/config.toml` carries a `[patch]` overlay redirecting every first-party
# dependency to a local working tree. Cargo finds that config by walking up from
# the current directory, so *any* cargo command run from inside the stack -- a
# test run, a check, a build -- rewrites `Cargo.lock` with every
# `source = "git+..."` line stripped. That lock resolves perfectly under the
# same overlay, which is why local verification never sees the problem, and
# fails every `--locked` job in CI, which has no overlay.
#
# The stack's `scripts/lockfile.py --check` runs cargo from outside the overlay
# and is the check the shared `lockfile-guard` workflow runs for a member whose
# CI calls it; not every member's CI does, so the hook is the check a push is
# certain to meet, ahead of any `--locked` CI job that fails on a flattened
# lock. This hook runs the checker from the stack's fetched default, beside
# the other stack tools; a
# member's own copy of the script (counted by `member_lockfile_copies`) is
# never run.
#
# Single source: this file is owned here and deployed outward to every
# member's `.githooks/` by `scripts/atlas-lock-form.py sync-hooks`
# (`--check` reports drift, which is what CI runs). Do not hand-edit member
# copies; change this file and re-sync. A member copy that differs from this
# file is drift, counted by the conformance `member_gate_versions` class.
#
# Install (git does not apply tracked hooks on its own):
#
#     python scripts/atlas-lock-form.py install-hooks
#
# Bypass deliberately:
#
#     SKIP_LOCAL_GATE=1 git push       (fast gate section only)
#
# SKIP_LOCKFILE_CHECK is not honoured: a lock check that fails, or cannot
# run, refuses the push either way. The arms that let a push through
# unchecked are a clone with no Atlas stack above it and a clone below a stack
# that does not register it: neither has a checker owed, each says so, and the
# lock is left to the `--locked` jobs of CI. A registered member, lane or
# harness worktree never takes either arm: a stack without a fetched default,
# or without the checker, refuses.
# coeus's checker contract (scripts/tests/
# test_hooks.py::test_skip_variable_cannot_hide_checker_failures) requires
# that no variable can hide a checker failure, and this hook's own skip used
# to exit 0 on an absent checker or interpreter -- hiding a failure exactly
# as completely as a failure would. The accepted cost: an offline push with a
# cold cargo cache now fails loudly instead of passing unverified.
set -euo pipefail

# The lockfile section below still runs unconditionally; only the
# no-manifest-in-range skip further down (evidence, not a bypass) can
# shorten it.
skip_lockfile=0
if [ "${SKIP_LOCKFILE_CHECK:-0}" = "1" ]; then
  echo "pre-push: SKIP_LOCKFILE_CHECK is no longer honoured; running the lockfile check anyway" >&2
fi

# Pin MSYS path conversion rather than inherit it. This hook hands native
# Windows `git.exe` filesystem paths (`git -C "$stack_root"`, where stack_root
# comes from `pwd` and is therefore `/c/...`), and MSYS rewrites those for us
# only while conversion is on. Windows developers commonly export
# MSYS_NO_PATHCONV globally to stop MSYS mangling unrelated arguments, and
# when they do every `-C` here resolves to a literal `\c\Users\...` that does
# not exist. The failure is silent in the way that matters most: the stack
# checker resolves to nothing, each checker reports itself "not reachable
# from this clone", and the hook exits 0. Blank is not equivalent to unset
# (both disable conversion), so it is genuinely unset here.
unset MSYS_NO_PATHCONV

# Capture the one-command prepared-tools selection before replacing inherited
# command configuration with the safe-directory setting child Git calls need.
prepared_tools_config="$(git -c safe.directory="$PWD" config --show-scope --get-all atlas.preparedTools 2>/dev/null || true)"
prepared_tools=""
prepared_tools_selected=0
if [ -n "$prepared_tools_config" ]; then
  if [[ "$prepared_tools_config" == *$'\n'* ]] \
    || [ "${prepared_tools_config%%$'\t'*}" != "command" ]; then
    echo "pre-push: BLOCKED -- atlas.preparedTools must be set once with git -c for this push." >&2
    exit 1
  fi
  prepared_tools_selected=1
  prepared_tools="${prepared_tools_config#*$'\t'}"
fi

# A managed worktree may be owned by a different filesystem account than the
# process pushing from it. Re-inject the checkout path so child Git calls stay
# valid without retaining other command-scoped configuration.
repo_root="$(git -c safe.directory="$PWD" rev-parse --show-toplevel)"
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0="$repo_root"
repo_git_dir="$(git rev-parse --absolute-git-dir)"
repo_store="$(git rev-parse --path-format=absolute --git-common-dir)"

# Every temporary directory this run creates is registered here and removed
# on any exit. The trap is set before the first one exists: the lock export
# is created long before the gate, and a push interrupted between the two
# leaked its export (1.5 GB for ritk). Each directory names its owner, so a
# later push can sweep what a killed one left behind (see below).
# Git exports GIT_DIR to hooks; a git process aimed at another repository
# must not inherit it (Stack tools, below). A subshell and `unset`, not
# `env -u`: the lock export runs this before an interpreter-free PATH has
# been refused, and such a PATH need not carry `env`.
outside_checkout() {
  (
    unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
    "$@"
  )
}

# The Atlas stack this checkout belongs to, or nothing: the nearest ancestor that
# is a git repository root with no superproject of its own (one that git cannot
# read around it is refused, not assumed to have none), registers members
# under `repos/` in its `.gitmodules`, and has one of those members share this
# checkout's object store. It is found by that identity and not by depth,
# since a member at `repos/<name>`, a lane under `worktrees/` and a harness
# worktree below a member sit at different depths beneath the same stack,
# while a `.gitmodules` planted in a member (which is itself a submodule of the
# stack, so never a stack), or a directory that only looks like a stack, owns
# none of them.
#
# The member is resolved from the checkout's object store directly: a
# member's store is `<stack>/.git/modules/<name>` or its own `.git`
# directory, so the registered entry that names it is tried first and
# confirmed by one git call, and every other member is probed only when
# that finds nothing (a member whose gitdir lives elsewhere, or a clone the
# stack does not register). The cost of a hit is therefore constant,
# wherever the member sits in `.gitmodules`.
#
# Exit status: 0 after setting the stack root and common directory, or with
# both empty for a clone with no stack above it; 2 with a message when the
# stack cannot be established (git cannot read a stack or one of its members,
# or cannot identify this checkout): the caller refuses; 3 after setting the
# nearest readable stack root and common directory when a stack sits above
# this clone but registers none of this clone's
# store (a `--shared` or `--reference` clone, a copy): the stack does not
# claim it, so the caller passes with a message that names the stack.
# Identical to the function in the other hook, which a test holds so.
locate_stack() {
  local probe="$1" own_store="$2" hook="${BASH_SOURCE[0]##*/}" line section name top path store unreadable
  local index stack_common superproject facts outer parent prefix unmatched="" unmatched_store=""
  local path_pattern='^[[:space:]]*path[[:space:]]*=[[:space:]]*(repos/[^[:space:]]+)[[:space:]]*$'
  local section_pattern='^[[:space:]]*\[submodule[[:space:]]+"(.*)"\][[:space:]]*$'
  local -a registered names order rest
  if [ -z "$own_store" ]; then
    echo "$hook: git cannot identify this checkout's object store, so the Atlas stack cannot be located; refusing" >&2
    return 2
  fi
  while :; do
    if [ -f "$probe/.gitmodules" ] && [ -e "$probe/.git" ]; then
    registered=()
    names=()
    section=""
    while IFS= read -r line || [ -n "$line" ]; do
      if [[ "$line" =~ $section_pattern ]]; then
        section="${BASH_REMATCH[1]}"
      elif [[ "$line" =~ $path_pattern ]]; then
        registered+=("${BASH_REMATCH[1]}")
        names+=("$section")
      fi
    done < "$probe/.gitmodules"
    if [ "${#registered[@]}" -gt 0 ]; then
    top=""
    stack_common=""
    superproject=""
    facts="$(outside_checkout git -C "$probe" rev-parse --path-format=absolute --show-toplevel --git-common-dir --show-superproject-working-tree 2>/dev/null || true)"
    { IFS= read -r top; IFS= read -r stack_common; IFS= read -r superproject; } <<<"$facts" || true
    prefix="$(outside_checkout git -C "$probe" rev-parse --show-prefix 2>/dev/null || true)"
    if [ -z "$top" ] || [ -n "$prefix" ]; then
      echo "$hook: the Atlas stack at $probe registers members but git cannot read it, so its lockfile checker cannot be used; refusing. If git reports dubious ownership and you trust that checkout: git config --global --add safe.directory $probe" >&2
      return 2
    fi
    # The superproject query prints nothing both when the candidate has none
    # and when git cannot read the repository around it, so it answers only if
    # that repository is readable: a candidate inside one git cannot read may be
    # a submodule of it (a member carrying its own `.gitmodules`), which no
    # stack is.
    outer="${probe%/*}"
    while [ -n "$outer" ] && [ ! -e "$outer/.git" ]; do
      parent="${outer%/*}"
      if [ "$parent" = "$outer" ]; then
        outer=""
      else
        outer="$parent"
      fi
    done
    if [ -n "$outer" ] && ! outside_checkout git -C "$outer" rev-parse --show-toplevel >/dev/null 2>&1; then
      echo "$hook: the candidate Atlas stack at $probe sits inside a repository at $outer that git cannot read, so it cannot be told apart from a submodule; refusing. If git reports dubious ownership and you trust that checkout: git config --global --add safe.directory $outer" >&2
      return 2
    fi
    if [ -z "$superproject" ] && [ -z "$outer" ]; then
    # A checkout whose own object store is the candidate stack's is the stack
    # root itself, so it matches the same way a registered member does.
    if [ "$own_store" = "$stack_common" ]; then
      stack_root="$probe"
      if ! stack_store="$(cd "$stack_common" && pwd)"; then
        echo "$hook: git identified the Atlas stack store at $stack_common but it cannot be opened; refusing" >&2
        return 2
      fi
      stack_member="<meta>"
      return 0
    fi
    order=()
    rest=()
    for index in "${!registered[@]}"; do
      path="${registered[$index]}"
      name="${names[$index]}"
      if [ "$own_store" = "$top/$path/.git" ] \
        || { [ -n "$name" ] && [ "$own_store" = "$stack_common/modules/$name" ]; }; then
        order+=("$path")
      else
        rest+=("$path")
      fi
    done
    unreadable=0
    for path in ${order[@]+"${order[@]}"} ${rest[@]+"${rest[@]}"}; do
      [ -e "$probe/$path/.git" ] || continue
      if ! store="$(outside_checkout git -C "$probe/$path" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)"; then
        unreadable=1
        continue
      fi
      if [ "$store" = "$own_store" ]; then
        stack_root="$probe"
        if ! stack_store="$(cd "$stack_common" && pwd)"; then
          echo "$hook: git identified the Atlas stack store at $stack_common but it cannot be opened; refusing" >&2
          return 2
        fi
        stack_member="${path##*/}"
        return 0
      fi
    done
    if [ "$unreadable" = 1 ]; then
      echo "$hook: a member registered by the Atlas stack at $probe cannot be read by git, so this checkout cannot be matched to the stack; refusing. If git reports dubious ownership and you trust it: git config --global --add safe.directory $probe/<member>" >&2
      return 2
    fi
    if [ -z "$unmatched" ]; then
      unmatched="$probe"
      unmatched_store="$stack_common"
    fi
    fi
    fi
    fi
    parent="${probe%/*}"
    if [ "$parent" = "$probe" ]; then
      probe=""
    else
      probe="$parent"
    fi
    if [ -z "$probe" ]; then
      if [ -n "$unmatched" ]; then
        stack_root="$unmatched"
        stack_store="$unmatched_store"
        return 3
      fi
      return 0
    fi
  done
}

tmp_base="${TMPDIR:-/tmp}"
run_temps=()
remove_run_temps() {
  local temp
  for temp in ${run_temps[@]+"${run_temps[@]}"}; do
    rm -rf "$temp" 2>/dev/null || true
  done
}
trap remove_run_temps EXIT
trap 'exit 129' HUP
trap 'exit 130' INT
trap 'exit 143' TERM
# new_run_temp <variable> <prefix>: a fresh directory, registered and owned.
new_run_temp() {
  local created
  created="$(mktemp -d "$tmp_base/$2.XXXXXX")"
  run_temps+=("$created")
  # The native spelling: Python and cargo read a Git Bash `/tmp/...` path
  # as a directory on the current drive.
  created="$(cd "$created" && { pwd -W 2>/dev/null || pwd; })"
  printf '%s\n' "$$" > "$created/.pre-push-owner"
  printf -v "$1" '%s' "$created"
}

# The remote's default branch is whatever the remote says it is: `origin/HEAD`
# follows a rename, `origin/main` does not (hephaestus defaults to `master`).
# Echoes the merge-base of `$1` with that branch, or nothing when neither
# ref resolves.
default_branch_base() {
  local tip="$1" ref base
  for ref in origin/HEAD origin/main; do
    base="$(git merge-base "$ref" "$tip" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      printf '%s' "$base"
      return 0
    fi
  done
  return 1
}

# The check measures the *working tree*, but the push carries a revision range.
# Those differ whenever the pushed commits were not checked out -- a plumbing
# push, or a push from a tree sitting on another branch -- and then the hook
# refuses a push on the strength of state that push does not contain. Read the
# range git supplies on stdin and skip when nothing in it touches dependency
# resolution: a push that changes no manifest and no lock cannot make the lock
# worse than the base already found acceptable.
#
# Git names one line per ref. A deletion carries no content, so a push of
# deletions alone has nothing to judge -- `HEAD` least of all. A push of
# several refs is several pushes: each is judged in its own run of this
# hook, since every section below judges one pushed revision and the range
# leading to it. Judging the first ref alone let a later ref carry anything.
zero="$(printf '0%.0s' $(seq 40))"
push_lines=()
if [ ! -t 0 ]; then
  while IFS= read -r push_line; do
    [ -n "$push_line" ] && push_lines+=("$push_line")
  done
fi

if [ "${#push_lines[@]}" -gt 0 ]; then
  for push_line in "${push_lines[@]}"; do
    read -r local_ref local_sha remote_ref remote_sha extra <<<"$push_line"
    [ -z "${extra:-}" ] || {
      echo "pre-push: BLOCKED -- malformed ref update" >&2
      exit 1
    }
    if [ "$local_sha" != "$zero" ] \
      && ! outside_checkout git -C "$repo_root" cat-file -e "$local_sha^{commit}" 2>/dev/null; then
      echo "pre-push: BLOCKED -- pushed local commit is unavailable" >&2
      exit 1
    fi
    if [ "$local_sha" != "$zero" ] && [ "$remote_sha" != "$zero" ] \
      && ! outside_checkout git -C "$repo_root" cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
      echo "pre-push: BLOCKED -- remote commit is unavailable" >&2
      exit 1
    fi
  done
fi

# A push of deletions alone carries nothing to judge, whatever state the stack
# is in: it is settled before the stack is looked for.
content_lines=()
for push_line in ${push_lines[@]+"${push_lines[@]}"}; do
  read -r _ push_sha _ <<<"$push_line"
  [ -n "${push_sha:-}" ] && [ "$push_sha" != "$zero" ] || continue
  content_lines+=("$push_line")
done
if [ "${#push_lines[@]}" -gt 0 ] && [ "${#content_lines[@]}" -eq 0 ]; then
  echo "pre-push: the push carries no commits; nothing to gate" >&2
  exit 0
fi

# The stack this checkout belongs to, located once for the rescue dispatch and
# the stack tools below. A stack git cannot read refuses here; a stack that
# does not register this clone is named in the messages below and gives it no
# checker (see locate_stack).
located=0
unmatched_stack=""
stack_root=""
stack_store=""
stack_member=""
locate_stack "$repo_root" "$repo_store" || located=$?
case "$located" in
  0) ;;
  3) unmatched_stack="$stack_root"; stack_root=""; stack_store=""; stack_member="" ;;
  *) exit 1 ;;
esac

# Both Atlas and member hooks dispatch to the classifier committed at the
# fetched stack default. The member revision cannot broaden its own exception.
if [ "${ATLAS_RESCUE_MIXED:-0}" != 1 ] && [ "${#push_lines[@]}" -gt 0 ]; then
  rescue_stack_root="$stack_root"
  rescue_stack_ref=""
  rescue_allowlist_ref=""
  for rescue_ref in origin/HEAD origin/main; do
    [ -n "$rescue_stack_root" ] || break
    rescue_stack_ref="$(outside_checkout git -C "$rescue_stack_root" rev-parse --verify --quiet "$rescue_ref^{commit}" 2>/dev/null || true)"
    [ -n "$rescue_stack_ref" ] && break
  done
  for rescue_ref in origin/HEAD origin/main; do
    rescue_allowlist_ref="$(outside_checkout git -C "$repo_root" rev-parse --verify --quiet "$rescue_ref^{commit}" 2>/dev/null || true)"
    [ -n "$rescue_allowlist_ref" ] && break
  done
  if [ -n "$rescue_stack_ref" ] && [ -n "$rescue_allowlist_ref" ] \
    && outside_checkout git -C "$rescue_stack_root" cat-file -e \
      "$rescue_stack_ref:scripts/git-hooks/rescue-push" 2>/dev/null; then
    rescue_status=0
    outside_checkout git -C "$rescue_stack_root" show \
      "$rescue_stack_ref:scripts/git-hooks/rescue-push" \
      | outside_checkout bash -s -- \
        "$repo_root" "$rescue_stack_root" "$rescue_stack_ref" \
        "$rescue_allowlist_ref" "${push_lines[@]}" || rescue_status=$?
    [ "$rescue_status" -eq 0 ] && exit 0
    [ "$rescue_status" -eq 3 ] || exit "$rescue_status"
  fi
fi

if [ "${#push_lines[@]}" -gt 0 ]; then
  if [ "${#push_lines[@]}" -gt 1 ]; then
    export ATLAS_RESCUE_MIXED=1
    refs_status=0
    for push_line in "${content_lines[@]}"; do
      echo "pre-push: judging ${push_line%% *}" >&2
      printf '%s\n' "$push_line" | bash "${BASH_SOURCE[0]}" "$@" || refs_status=1
    done
    exit "$refs_status"
  fi
fi

touches_dependency_state=unknown
pushed_tip=""
# The range this push carries, for the local gate far below. Recorded here
# because stdin reads once: the gate cannot re-read it.
gate_tip=""
gate_range_base=""
if [ "${#content_lines[@]}" -eq 1 ]; then
  touches_dependency_state=no
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    if [ "$remote_sha" = "$zero" ]; then
      # New branch: compare against the merge-base with the default branch,
      # so a long series is not read as touching everything. Comparing
      # against HEAD instead is vacuous exactly when it matters: pushing
      # the checked-out branch makes the base the pushed tip itself, the
      # range is empty, and a manifest-changing push skips the check.
      base="$(default_branch_base "$local_sha" || true)"
      if [ -z "$base" ]; then
        # No history shared with the default branch (an orphan branch, or
        # no default branch known): the pushed revision is judged whole.
        gate_tip="$local_sha"
        gate_range_base=""
        touches_dependency_state=unknown
        break
      fi
    elif git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      # Ordinary branch updates extend the remote tip, so only new commits
      # enter the gate range.
      base="$remote_sha"
    else
      # Publication branches may be rebuilt from a newer default branch.
      # Their previous tip is then outside the new history; gate the PR delta
      # from the new tip's default-branch base rather than unrelated mainline
      # changes between the two generated commits.
      base="$(default_branch_base "$local_sha" || true)"
      if [ -z "$base" ]; then
        gate_tip="$local_sha"
        gate_range_base=""
        touches_dependency_state=unknown
        break
      fi
    fi
    if [ -z "$gate_tip" ]; then
      gate_tip="$local_sha"
      gate_range_base="$base"
    fi
    if ! changed="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"; then
      touches_dependency_state=unknown
      break
    fi
    if printf '%s\n' "$changed" | grep -qE '(^|/)Cargo\.(lock|toml)$'; then
      touches_dependency_state=yes
      pushed_tip="$local_sha"
      break
    fi
  done <<PUSHED
${content_lines[0]}
PUSHED
fi

# No manifest in the range means the lock cannot have changed: skip its check,
# but still run the code gate -- a source-only push still needs lint and tests.
if [ "$touches_dependency_state" = "no" ]; then
  echo "pre-push: no Cargo.lock or Cargo.toml in the pushed range; lockfile check not needed" >&2
  skip_lockfile=1
fi

# `--check` measures the working tree, so its verdict is evidence about the
# pushed commits only while the two agree on dependency state. They diverge
# exactly when it matters: any cargo command rewrites `Cargo.lock`, so a tree
# whose lock a test run already repaired passes this check while the commits
# being pushed still carry the stale one. That is how a stale lock reached
# main once and failed every `--locked` job after it.
#
# The interpreter is resolved here, before any section that may be skipped:
# the lockfile section below is skipped on every push that leaves manifests
# alone, and under `set -u` a later reader of `python_bin` -- the SAFETY
# ratchet below -- would then abort the hook instead of running.
python_bin="${PYTHON:-}"
if [ -z "$python_bin" ]; then
  for candidate in python3 python; do
    # Probe the candidate, not just its presence on PATH: the WindowsApps
    # python3.exe Store stub passes `command -v` and then fails to execute
    # (rc 127), and selecting it makes every `"$python_bin" -c ...` below
    # fail -- the workspace-membership pipeline in particular, which under
    # `set -o pipefail` blocks the push with a diagnostic about cargo that
    # the interpreter caused. Same probe as `.githooks/pre-commit`.
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1; then
      python_bin="$candidate"
      break
    fi
  done
fi

# export_revision <sha> <dir>: <dir> becomes a checkout of <sha> in a
# repository of its own that borrows this member's object store, so the
# identity checker reads the pushed commit as its `HEAD`.
#
# The files are written by `read-tree -u` run in the member itself, against
# the export's index and work tree: the member is where a partial clone's
# promisor remote lives, so blobs it never fetched are fetched on demand (the
# export repository alone refused every tree with such a blob: 13 of 28
# members are `blob:none`). `core.longpaths` lets a deep path exceed 260
# characters on Windows (kwavers carries 159-character paths), and sparse
# checkout is off so the whole tree is written. A checkout, not `git archive
# | tar`: links are written as links (as files where `core.symlinks` is
# false) and never followed. Run against an existing export, `--reset -u`
# rewrites only the files that differ, so unchanged files keep their times
# and cargo's fingerprints stay fresh; files the tree does not track are
# removed. The index carries stat data, so the identity checker's
# `git diff HEAD` compares stats instead of re-hashing the tree. Automatic
# gc and maintenance are off for the member-side read and the fetches it
# starts: a push must not repack the member it reads (moirai's auto-gc
# fails on a foreign ref), and the export reads the member's objects.
export_revision() (
  local sha="$1" directory="$2"
  unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_COMMON_DIR
  # `git init` creates the directory: the lock export runs before a PATH
  # without an interpreter is refused, and such a PATH need not carry mkdir.
  if [ ! -d "$directory/.git" ]; then
    git init -q "$directory" || return 1
  fi
  printf '%s\n' "$repo_store/objects" > "$directory/.git/objects/info/alternates" \
    && git -C "$directory" config core.longpaths true \
    && git -C "$directory" config gc.auto 0 \
    && git -C "$directory" config maintenance.auto false \
    && GIT_DIR="$repo_git_dir" GIT_WORK_TREE="$directory" GIT_INDEX_FILE="$directory/.git/index" \
      git -c core.longpaths=true -c core.sparseCheckout=false -c gc.auto=0 -c maintenance.auto=false \
        read-tree -u --reset "$sha" \
    && git -C "$directory" update-ref HEAD "$sha" \
    && git -C "$directory" clean -ffdxq
)

# Exports a killed push left behind (ritk's reached 1.5 GB each). A directory
# naming its owner (`.pre-push-owner`) goes only once that pid is gone. One
# naming none was written by an older hook that records no owner and may
# still be building in it -- a run can take most of an hour -- so it goes only
# after a day. The sweep visits every leftover of every push since the last
# one, and a spawned process costs most of a second on a loaded Windows host,
# so it spawns none per entry: ages compare against two marker files
# (`-ot`), and owners and holders read by `read`, which unlike a command
# substitution keeps the carriage return of a file written on Windows. A marker
# that could not be written compares false, so a failed `touch` keeps every
# entry.
new_run_temp age_marks pl
touch -d '1 day ago' "$age_marks/day" 2>/dev/null || true
touch -d '7 days ago' "$age_marks/week" 2>/dev/null || true
for stale in "$tmp_base"/pre-push-lock.* "$tmp_base"/pre-push-gate.* "$tmp_base"/pl.* "$tmp_base"/pg.* "$tmp_base"/pg-log.* "$tmp_base"/pg-casts.*; do
  [ -e "$stale" ] || continue
  stale_owner=""
  { read -r stale_owner < "$stale/.pre-push-owner"; } 2>/dev/null || true
  stale_owner="${stale_owner%$'\r'}"
  if [ -n "$stale_owner" ]; then
    kill -0 "$stale_owner" 2>/dev/null && continue
  else
    [ "$stale" -ot "$age_marks/day" ] || continue
  fi
  rm -rf "$stale" 2>/dev/null || true
done
# A checkout's reusable export (see the gate below) outlives its runs by
# design; one no run has claimed for a week belongs to a checkout that is
# gone, and goes unless a live run holds its lock.
for stable in "$tmp_base"/pg-??????????; do
  [ -d "$stable" ] || continue
  holder=""
  { read -r holder < "$stable.lock/pid"; } 2>/dev/null || true
  holder="${holder%$'\r'}"
  [ -n "$holder" ] && kill -0 "$holder" 2>/dev/null && continue
  [ "$stable" -ot "$age_marks/week" ] || continue
  rm -rf "$stable" "$stable.lock" 2>/dev/null || true
done


# ---------------------------------------------------------------------------
# Stack tools are owned by the stack and run from committed revisions, never
# from the stack checkout. The artifact-budget checker, secret scanner, and
# lock checker always come from the fetched default (`origin/HEAD`, else
# `origin/main`). The conformance and source-identity checkers also default to
# that revision. A provider-preparation push may select one immutable Atlas
# commit for those two tools only with `git -c atlas.preparedTools=<full-sha>`.
# The selected revision's `scripts/` is extracted once into the stack's git
# directory. A standalone clone outside the stack has no baseline, and each
# tool reports itself unreachable.
#
# Git exports GIT_DIR to hooks -- an absolute path in a lane -- and a git or
# checker process aimed at another repository inherits it and answers about
# this checkout instead: from a hephaestus lane, the stack's `origin/HEAD`
# resolved to hephaestus's own and the ratchet was skipped as unreachable.
# Every such process runs through `outside_checkout` (defined at the top).
stack_baseline=""
if [ -n "$stack_root" ]; then
  for ref in origin/HEAD origin/main; do
    stack_baseline="$(outside_checkout git -C "$stack_root" rev-parse --verify --quiet "$ref^{commit}" 2>/dev/null || true)"
    [ -n "$stack_baseline" ] && break
  done
fi
member_baseline=""
for ref in origin/HEAD origin/main; do
  member_baseline="$(outside_checkout git -C "$repo_root" rev-parse --verify --quiet "$ref^{commit}" 2>/dev/null || true)"
  [ -n "$member_baseline" ] && break
done
extract_stack_scripts() {
  local revision="$1"
  local checker_cache checker_dir staging checker_users checker_marker
  local copy copy_in_use user
  extracted_stack_scripts=""
  if [ -z "$revision" ] \
    || ! outside_checkout git -C "$stack_root" cat-file -e "$revision:scripts" 2>/dev/null; then
    return
  fi
  checker_cache="$stack_store/atlas-checker"
  checker_dir="$checker_cache/$revision"
  if [ ! -d "$checker_dir/scripts" ]; then
    mkdir -p "$checker_cache"
    staging="$(mktemp -d "$checker_cache/.staging.XXXXXX")"
    outside_checkout git -C "$stack_root" archive "$stack_baseline" scripts | tar -x -C "$staging"
    # A concurrent push may have placed the same revision first; either
    # copy is the same content, so losing that race is not an error. A
    # rename can also fail with no winner (Windows refuses one while any
    # process holds a file open), and deleting the copy then left no
    # checker at all; this run uses its own copy and removes it on exit.
    if ! mv "$staging" "$checker_dir" 2>/dev/null; then
      if [ -d "$checker_dir/scripts" ]; then
        rm -rf "$staging"
      else
        run_temps+=("$staging")
        checker_dir="$staging"
      fi
    fi
  fi
  # A run marks the copy it uses for its whole lifetime, and a copy is pruned
  # only once it is an hour old and no live run marks it: pruning by age
  # alone deleted copies that running gates were still reading.
  checker_users="$checker_cache/.users"
  mkdir -p "$checker_users"
  checker_marker="$checker_users/${checker_dir##*/}.$$"
  : > "$checker_marker"
  run_temps+=("$checker_marker")
  if [ -n "$python_bin" ]; then
    for copy in "$checker_cache"/*/; do
      copy="${copy%/}"
      [ "$copy" = "$checker_dir" ] && continue
      "$python_bin" -c 'import os, sys, time; sys.exit(time.time() - os.path.getmtime(sys.argv[1]) < 3600)' "$copy" || continue
      copy_in_use=0
      for user in "$checker_users/${copy##*/}".*; do
        [ -f "$user" ] || continue
        if kill -0 "${user##*.}" 2>/dev/null; then
          copy_in_use=1
        else
          rm -f "$user"
        fi
      done
      [ "$copy_in_use" -eq 0 ] && rm -rf "$copy"
    done
  fi
  if [ -d "$checker_dir/scripts" ]; then
    extracted_stack_scripts="$checker_dir/scripts"
  fi
}

stack_scripts=""
if [ -n "$stack_baseline" ]; then
  extract_stack_scripts "$stack_baseline"
  stack_scripts="$extracted_stack_scripts"
fi
prepared_stack_scripts=""
if [ "$prepared_tools_selected" -eq 1 ]; then
  if [[ ! "$prepared_tools" =~ ^[0-9a-f]{40}$ ]]; then
    echo "pre-push: BLOCKED -- atlas.preparedTools must name one full 40-character commit ID." >&2
    exit 1
  elif [ -z "$stack_root" ] || [ -n "$unmatched_stack" ]; then
    echo "pre-push: BLOCKED -- atlas.preparedTools is valid only in the registered Atlas stack." >&2
    exit 1
  elif ! outside_checkout git -C "$stack_root" cat-file -e "$prepared_tools^{commit}" 2>/dev/null; then
    echo "pre-push: BLOCKED -- atlas.preparedTools commit $prepared_tools is unavailable in the Atlas object store." >&2
    exit 1
  fi
  new_run_temp prepared_root apt
  if ! outside_checkout git -C "$stack_root" archive "$prepared_tools" scripts \
    | tar -x -C "$prepared_root"; then
    echo "pre-push: BLOCKED -- atlas.preparedTools commit $prepared_tools could not be extracted." >&2
    exit 1
  fi
  prepared_stack_scripts="$prepared_root/scripts"
  if [ ! -f "$prepared_stack_scripts/atlas-conformance.py" ] \
    || [ ! -f "$prepared_stack_scripts/atlas-build-identity.py" ] \
    || [ ! -f "$prepared_stack_scripts/atlas_stack.py" ]; then
    echo "pre-push: BLOCKED -- atlas.preparedTools commit $prepared_tools lacks a required prepared tool." >&2
    exit 1
  fi
  echo "pre-push: conformance and source identity use prepared Atlas tools $prepared_tools" >&2
fi

# The skips above fall through to the code gate, so this whole section runs
# only when the lock still wants verifying.
checker="${stack_scripts:+$stack_scripts/lockfile.py}"
if [ "$skip_lockfile" = "0" ]; then
# The lock is checked on an export of the pushed revision, outside the stack,
# by the stack's own `scripts/lockfile.py` from the fetched default (Stack
# tools, above): the working tree is neither the push (a peer's branch, a
# plumbing push) nor stable (any cargo command inside the stack flattens its
# lock), so a verdict on it was evidence about the wrong state either way. The
# checker is always the stack's, never a member's own `scripts/lockfile.py`
# (all 28 members carry one today, and retiring them is atlas#478's
# `publish-hooks --retire`), so a member's copy cannot overrule it. The
# dependency-source check below reads the same export.
lock_rev="${pushed_tip:-${gate_tip:-HEAD}}"
new_run_temp lock_root pl
lock_export="$lock_root/tree"
if ! export_revision "$(git rev-parse --verify "$lock_rev^{commit}")" "$lock_export"; then
  echo "pre-push: could not export $lock_rev for the lockfile check" >&2
  exit 1
fi
if [ -n "$unmatched_stack" ]; then
  # No lockfile checker is owed to a clone the stack does not register, and a
  # lock that gets through here meets the `--locked` CI jobs and is repaired by
  # regenerating it; the credential gate, whose push cannot be taken back,
  # refuses such a clone instead.
  echo "pre-push: inside the Atlas stack at $unmatched_stack but not one of its registered members, so the stack's lockfile checker is not used and the lock is not verified here. Work in a registered member or a lane to have it checked" >&2
elif [ -z "$stack_root" ]; then
  echo "pre-push: no Atlas stack above this clone, so there is no lockfile checker to run; the lock is not verified here, and a flattened one fails the --locked CI jobs" >&2
elif [ -z "$stack_baseline" ]; then
  # Inside a stack the checker is owed, so a stack that cannot supply one
  # refuses rather than passing as a clone outside any stack would.
  echo "pre-push: the stack at $stack_root has neither origin/HEAD nor origin/main, so its lockfile checker cannot be extracted; lockfile not verified. Run: git -C $stack_root fetch origin" >&2
  exit 1
elif [ ! -f "$checker" ]; then
  # A guard that reports its own absence and lets the push through is the
  # absence. The stack is reachable here, so its fetched default is what
  # lacks the checker (or could not be extracted), and the lock is what this
  # section is for -- refuse; there is no deliberate way through.
  echo "pre-push: the stack's scripts at ${stack_baseline:0:12} carry no lockfile.py; lockfile not verified" >&2
  exit 1
elif [ -z "$python_bin" ]; then
  echo "pre-push: no python interpreter found; lockfile not verified" >&2
  exit 1
elif [ "$stack_member" = "<meta>" ]; then
  echo "pre-push: nested Cargo lock checks follow Atlas meta-root owner selection" >&2
elif ! (cd "$lock_export" && "$python_bin" "$checker" --check --manifest-path "$lock_export/Cargo.toml"); then
  cat >&2 <<MESSAGE

pre-push: the Cargo.lock in $lock_rev does not resolve under --locked, so
every CI job that passes --locked would fail on this push.

The usual cause is a cargo command run from inside the Atlas stack, which
strips the lock's git sources. Repair it from the member's root with:

    python3 $stack_root/scripts/lockfile.py --regenerate --manifest-path Cargo.toml

then stage the result and push again.
MESSAGE
  exit 1
fi

# Dependency sources. A lock advance can bring in git sources `deny.toml`
# does not allow, and nothing above reads them: harmonia#19 merged on a green
# `--locked` build and left CI red until harmonia#21 allowed three new
# first-party sources. cargo-deny cannot run in this checkout -- it resolves
# from the workspace root, so inside the stack the development overlay
# answers, every git source reads as unencountered, `sources ok` is vacuous,
# and the lock is rewritten -- so it runs on an export of the pushed revision
# outside the stack, which is exactly what CI resolves. The working tree is
# never touched.
if [ -f "$lock_export/deny.toml" ]; then
  if ! cargo deny --version >/dev/null 2>&1; then
    echo "pre-push: cargo-deny is not installed, so the dependency sources of this" >&2
    echo "lock change are unverified. Install it: cargo install --locked cargo-deny" >&2
    exit 1
  fi
  if ! (cd "$lock_export" && cargo deny --locked check sources >&2); then
    cat >&2 <<MESSAGE

pre-push: the pushed Cargo.lock resolves a source deny.toml does not allow,
so the CI supply-chain job would fail on this push. Allow the source in
deny.toml (a first-party git source goes under [sources] allow-git) or drop
the dependency.
MESSAGE
    exit 1
  fi
fi
fi
# End of the lockfile section; the code gate below runs unconditionally.

# ---------------------------------------------------------------------------
# Artifact budgets: PM boards under their line budget, tracked images under
# their byte budget (scripts/atlas-artifact-budget.py, ratchet-to-budget: an
# over-budget board may not grow, an oversized image may not be added or
# touched). Boards reached 6,325/7,609/7,570 lines and screenshots 1.5 MB in
# one member before anything measured either. The script lives in the stack
# root; a standalone clone outside the stack reports and continues, since the
# shared CI workflow (artifact-budget.yml) is the authoritative gate there.
# The gate judges the pushed tip against the pushed range's base, never the
# working tree a peer may hold dirty and never `HEAD`: a plumbing push, or a
# shared tree checked out on a peer's branch, makes `HEAD` a revision this push
# does not carry, and a peer's over-budget board then refused an unrelated
# push. `HEAD` against its upstream remains the fallback when git supplied no
# range (a manual run with no stdin).
range_rev="${gate_tip:-HEAD}"
range_base=""
if [ -n "$gate_range_base" ] \
  && git rev-parse --verify --quiet "$gate_range_base^{commit}" >/dev/null 2>&1; then
  range_base="$gate_range_base"
elif [ -z "$gate_tip" ] \
  && upstream="$(git rev-parse --verify --quiet '@{upstream}' 2>/dev/null)"; then
  range_base="$upstream"
else
  range_base="$(default_branch_base "$range_rev" || true)"
fi
range_args=()
[ -n "$range_base" ] && range_args=(--base "$range_base")

budget_checker="${stack_scripts:+$stack_scripts/atlas-artifact-budget.py}"
if [ -f "$budget_checker" ] && [ -n "$python_bin" ]; then
  if ! "$python_bin" "$budget_checker" check --root "$repo_root" --rev "$range_rev" "${range_args[@]}"; then
    echo "pre-push: BLOCKED -- a PM board grew past its line budget or a tracked" >&2
    echo "image exceeds the byte budget. Compact the board (done items delete)," >&2
    echo "move evidence captures out of git, and push again." >&2
    exit 1
  fi
else
  echo "pre-push: artifact-budget checker not reachable from this clone; CI enforces it" >&2
fi

# Credentials: every commit the pushed range introduces, scanned before it
# leaves the machine (scripts/atlas-secret-scan.py). A secret that reaches a
# remote is published -- a rewritten history does not unpublish it -- so this
# is the one check CI cannot stand in for: by the time a runner sees the push,
# the value is already out, and a scan that could not run blocks the push. Same
# range as the budget check above.
secret_checker="${stack_scripts:+$stack_scripts/atlas-secret-scan.py}"
if [ ! -f "$secret_checker" ]; then
  if [ -n "$unmatched_stack" ]; then
    # The lock check above passes such a clone; a credential cannot be taken
    # back once pushed, so this stage refuses it.
    echo "pre-push: BLOCKED -- inside the Atlas stack at $unmatched_stack but not one of its registered members," >&2
    echo "so the trusted credential scanner is not used and the pushed range was not scanned. Push from a registered member or a lane of it." >&2
  else
    echo "pre-push: BLOCKED -- the trusted credential scanner is not reachable from this clone;" >&2
    echo "the pushed range was not scanned. Fetch the stack's default branch and push again." >&2
  fi
  exit 1
fi
if [ -z "$python_bin" ]; then
  echo "pre-push: BLOCKED -- no python interpreter; the pushed range was not scanned for credentials." >&2
  exit 1
fi
if [ -z "$member_baseline" ]; then
  echo "pre-push: BLOCKED -- member default revision is unavailable for the trusted allowlist." >&2
  exit 1
fi
secret_status=0
"$python_bin" -I "$secret_checker" check --root "$repo_root" --rev "$range_rev" \
    --allowlist-rev "$member_baseline" "${range_args[@]}" || secret_status=$?
if [ "$secret_status" -eq 1 ]; then
  echo "pre-push: BLOCKED -- the pushed range adds a credential. Remove it from" >&2
  echo "every commit in the range; if it ever reached a remote, rotate it." >&2
  exit 1
elif [ "$secret_status" -ne 0 ]; then
  echo "pre-push: BLOCKED -- the secret scan could not run (exit $secret_status), so the pushed" >&2
  echo "range was not scanned; the reason is the secret-scan line above." >&2
  exit 1
fi

# Debt ratchet: the pushed revision's conformance classes may not rise above
# the counts atlas records for this member. CI runs the same script through
# conformance-guard.yml (`atlas-conformance.py check --repo <member>
# --member-path .`); nothing local did, so metis#394 passed every stage here
# and then failed CI on `oversized_files: 0 -> 1` and
# `existence_only_assertions: 0 -> 1`.
#
# Every input is a committed revision. The content is the pushed tip
# (`--member-revision`), never the working tree a peer may hold on another
# branch or dirty. The checker defaults to the stack's fetched revision. An
# explicit prepared-tools selection changes the checker code, while the
# comparison baseline remains the fetched default. The checker runs with
# `ATLAS_STACK_ROOT` naming the live stack, since cited hashes resolve against
# every member's object store and only the stack holds them all.
# Citations resolve through default branches and tags only, so a branch
# deleted elsewhere cannot refuse a push that cites nothing new.
if [ -n "$stack_baseline" ] && [ -n "$python_bin" ] \
  && outside_checkout git -C "$stack_root" cat-file -e "$stack_baseline:scripts/atlas-conformance.py" 2>/dev/null; then
  # The root's pushed revision carries the meta row and every recorded
  # gitlink, so it takes the stack scan. A member is the registered directory
  # sharing this checkout's object store; a lane therefore resolves to its
  # repository rather than to its worktree directory.
  if [ -z "$stack_member" ]; then
    echo "pre-push: not a registered stack member; debt ratchet not run" >&2
  else
    conformance_scripts="${prepared_stack_scripts:-$stack_scripts}"
    conformance_checker="${conformance_scripts:+$conformance_scripts/atlas-conformance.py}"
    if [ ! -f "$conformance_checker" ]; then
      echo "pre-push: BLOCKED -- could not extract the stack's checker for $stack_member." >&2
      exit 1
    elif ! grep -q ATLAS_STACK_ROOT "$conformance_scripts/atlas_stack.py"; then
      # The selected checker predates revision scans and cannot judge a
      # committed revision without falling back to mutable checkout state.
      echo "pre-push: the stack's checker for $stack_member predates revision scans;" >&2
      echo "debt ratchet not run. Run: git -C $stack_root fetch origin" >&2
    else
      conformance_args=(check --baseline-rev "$stack_baseline")
      if [ "$stack_member" = "<meta>" ]; then
        conformance_args+=(--revision "$range_rev")
      else
        conformance_args+=(--repo "$stack_member" --member-path "$repo_root" \
          --member-revision "$range_rev")
      fi
      set +e
      ATLAS_STACK_ROOT="$stack_root" outside_checkout "$python_bin" "$conformance_checker" \
        "${conformance_args[@]}" \
        >&2
      conformance_status=$?
      set -e
      if [ "$conformance_status" -eq 1 ]; then
        echo "pre-push: BLOCKED -- the pushed revision raises a debt class above the" >&2
        echo "baseline atlas ${stack_baseline:0:12} records for $stack_member." >&2
        echo "Fix the debt; never regenerate the baseline over it. Reproduce:" >&2
        echo "  ATLAS_STACK_ROOT=$stack_root python $conformance_checker ${conformance_args[*]}" >&2
        exit 1
      elif [ "$conformance_status" -ne 0 ]; then
        echo "pre-push: BLOCKED -- the debt ratchet could not run (exit $conformance_status)." >&2
        exit 1
      fi
    fi
  fi
else
  echo "pre-push: no stack checker reachable from this clone; debt ratchet not run, CI enforces it" >&2
fi

# ---------------------------------------------------------------------------
# Fast local gate, scoped to the pushed range.
#
# The lockfile guard above is one third of what CI runs, and the other two
# thirds are where defects have actually escaped: a merge once landed two
# clippy denials that turned the architecture validation red on main and on
# every pull request that merged it, because nothing local ran clippy.
# CI should confirm, not discover.
#
# Scope is the push, not the workspace: a workspace clippy takes minutes on a
# large member, and a gate that slow is a gate people bypass. The changed files
# map to their packages and only those are linted and tested.
#
# Every step reads an export of the pushed revision, never the checkout. The
# checkout is not the push: the stack commits through a private index onto an
# item branch nobody checked out, and a shared tree holds a peer's branch and
# uncommitted files. Gating the checkout judged that state -- ritk's fmt
# failed on a peer's uncommitted layout modules -- and refusing a push whose
# tip differed from it refused every private-index push.
#
# The export is a fresh checkout of the pushed commit (`export_revision`), so
# every file takes the current time and no cached build of older content
# passes for this content. It sits in a temporary directory outside the stack,
# because inside it the stack's `[patch]` overlay redirects this member's
# packages to its main tree beside the export's own copies ("package collision
# in the lockfile"). Outside it the export resolves its committed `Cargo.lock`, so
# every resolving step passes `--locked`, exactly as CI does. The rest of the
# stack's cargo configuration still applies -- its profile keys hash every
# shared artifact -- so each `.cargo/config.toml` above the member is copied,
# `[patch]` tables removed, to the same nesting above the export, and the
# stack's target directory is exported: the gate uses the one shared cache.
#
# The export's repository has the pushed commit as `HEAD`, so the source
# identity checker records the pushed revision as the build's source --
# never the checkout's `HEAD`.
#
# Bypass deliberately:
#
#     SKIP_LOCAL_GATE=1 git push

if [ "${SKIP_LOCAL_GATE:-0}" = "1" ]; then
  echo "pre-push: local gate skipped by SKIP_LOCAL_GATE" >&2
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  # No toolchain on this machine (docs-only checkout, bare CI image without
  # Rust): say so rather than failing every push on a missing binary.
  echo "pre-push: no cargo toolchain found; local gate not run" >&2
  exit 0
fi

# Select from the pushed range where git supplied one: `HEAD` is the
# checkout's branch, which a plumbing push or a tree sitting on a peer's branch
# makes the wrong revision to select from. A base the local repository cannot
# resolve -- a remote tip never fetched here -- falls back rather than diffing
# against nothing, which would read as "no Rust in the range" and skip the gate.
if [ -n "$gate_range_base" ] \
  && ! git rev-parse --verify --quiet "$gate_range_base^{commit}" >/dev/null 2>&1; then
  gate_range_base=""
fi
gate_tip_rev="${gate_tip:-HEAD}"
gate_sha="$(git rev-parse --verify --quiet "$gate_tip_rev^{commit}" || true)"
if [ -z "$gate_sha" ]; then
  echo "pre-push: cannot resolve the pushed revision $gate_tip_rev" >&2
  exit 1
fi
if [ -n "$gate_range_base" ]; then
  gate_base="$gate_range_base"
else
  gate_base="$(default_branch_base "$gate_sha" || true)"
fi

if [ -n "$gate_base" ]; then
  if ! gate_changed="$(git diff --name-only "$gate_base" "$gate_sha")"; then
    echo "pre-push: BLOCKED -- could not discover changed paths between $gate_base and $gate_sha." >&2
    exit 1
  fi
else
  # No history shared with the default branch: every file is new.
  if ! gate_changed="$(git ls-tree -r --name-only "$gate_sha")"; then
    echo "pre-push: BLOCKED -- could not discover paths from $gate_sha." >&2
    exit 1
  fi
fi

if [ -z "$python_bin" ]; then
  echo "pre-push: no python interpreter found; Cargo workspace membership not verified" >&2
  echo "pre-push: push anyway with SKIP_LOCAL_GATE=1 git push" >&2
  exit 1
fi

# The stack's cargo configuration, outermost first: cargo merges every
# `.cargo/config.toml` above its working directory, the nearest winning.
stack_configs=()
search_dir="$(dirname "$repo_root")"
while :; do
  if [ -f "$search_dir/.cargo/config.toml" ]; then
    stack_configs=("$search_dir/.cargo/config.toml" ${stack_configs[@]+"${stack_configs[@]}"})
  fi
  parent="$(dirname "$search_dir")"
  [ "$parent" = "$search_dir" ] && break
  search_dir="$parent"
done

# The export lives at one short path per checkout, reused run after run:
# cargo fingerprints a package by its path, so a new directory per push
# rebuilt every workspace package (hermes: 419 s for a re-push of one sha,
# 567 s cold), and a short root keeps deep paths under Windows' limit. A run
# claims it with a lock naming its pid; while a live run holds it, this run
# builds in a temporary export instead of waiting, and a dead holder's lock
# is taken over.
gate_key="$(printf '%s' "$repo_root" | git hash-object --stdin | cut -c1-10)"
gate_root="$tmp_base/pg-$gate_key"
claim_gate_root() {
  local staged="$gate_root.lock.$$"
  mkdir -p "$staged" && printf '%s\n' "$$" > "$staged/pid" || return 1
  if mv -T "$staged" "$gate_root.lock" 2>/dev/null; then
    run_temps+=("$gate_root.lock")
    return 0
  fi
  rm -rf "$staged"
  return 1
}
if ! claim_gate_root; then
  gate_holder="$(cat "$gate_root.lock/pid" 2>/dev/null || true)"
  if [ -n "$gate_holder" ] && ! kill -0 "$gate_holder" 2>/dev/null; then
    rm -rf "$gate_root.lock"
  fi
  if ! claim_gate_root; then
    echo "pre-push: the checkout's export is in use by pid ${gate_holder:-?}; building in a fresh one" >&2
    new_run_temp gate_root pg
  fi
fi
mkdir -p "$gate_root"
# Its age is the time since a run last claimed it (the week-long sweep above).
touch "$gate_root"
gate_root="$(cd "$gate_root" && { pwd -W 2>/dev/null || pwd; })"
gate_log=""

# Mirror each config above the export without its `[patch]` table, and find
# the shared target directory: the nearest config naming `build.target-dir`,
# relative to the directory holding its `.cargo`. A TOML parser, not a line
# filter: `[patch]` has dotted-key and inline forms, a patch table can hold an
# array whose lines begin with `[`, and a target dir may be single-quoted.
# Prints the directory to export into, then the target directory or nothing.
if ! gate_layout="$("$python_bin" - "$gate_root" ${stack_configs[@]+"${stack_configs[@]}"} <<'PY'
import json
import pathlib
import sys
import tomllib

# LF lines: bash keeps the CR a Windows text-mode stdout adds.
sys.stdout.reconfigure(newline='\n')


def key(name):
    return json.dumps(name, ensure_ascii=False)


def value(item):
    if isinstance(item, bool):
        return 'true' if item else 'false'
    if isinstance(item, (int, float)):
        return repr(item)
    if isinstance(item, str):
        return json.dumps(item, ensure_ascii=False)
    if isinstance(item, list):
        return '[' + ', '.join(value(entry) for entry in item) + ']'
    if isinstance(item, dict):
        return '{' + ', '.join(f'{key(k)} = {value(v)}' for k, v in item.items()) + '}'
    return json.dumps(item.isoformat())


def table(path, body, lines):
    scalars = {k: v for k, v in body.items() if not isinstance(v, dict)}
    if path and (scalars or not body):
        lines.append('[' + '.'.join(key(part) for part in path) + ']')
    lines.extend(f'{key(k)} = {value(v)}' for k, v in scalars.items())
    for name, child in body.items():
        if isinstance(child, dict):
            table([*path, name], child, lines)


parent = pathlib.Path(sys.argv[1])
target = ''
for config in sys.argv[2:]:
    source = pathlib.Path(config)
    with source.open('rb') as stream:
        data = tomllib.load(stream)
    data.pop('patch', None)
    build = data.get('build')
    configured = build.get('target-dir') if isinstance(build, dict) else None
    if isinstance(configured, str) and configured:
        chosen = pathlib.Path(configured)
        target = str(chosen if chosen.is_absolute() else source.parent.parent / chosen)
    lines = []
    table([], data, lines)
    (parent / '.cargo').mkdir(parents=True, exist_ok=True)
    mirrored = parent / '.cargo' / 'config.toml'
    content = ('\n'.join(lines) + '\n').encode()
    if not mirrored.is_file() or mirrored.read_bytes() != content:
        mirrored.write_bytes(content)
    parent = parent / 'nested'
print(parent)
print(target)
PY
)"; then
  echo "pre-push: could not read the stack's cargo configuration" >&2
  exit 1
fi
{ read -r gate_parent; read -r gate_target || true; } <<<"$gate_layout"
if [ -z "${CARGO_TARGET_DIR:-}" ]; then
  export CARGO_TARGET_DIR="${gate_target:-$repo_root/target}"
fi

gate_export="$gate_parent/${repo_root##*/}"
mkdir -p "$gate_export"
gate_export="$(cd "$gate_export" && { pwd -W 2>/dev/null || pwd; })"
# A reused export a killed run left half-written can refuse the update;
# it is only a cache, so it is rebuilt once from nothing.
if ! export_revision "$gate_sha" "$gate_export"; then
  rm -rf "$gate_export" && mkdir -p "$gate_export"
  if ! export_revision "$gate_sha" "$gate_export"; then
    echo "pre-push: could not export $gate_sha for the local gate" >&2
    exit 1
  fi
fi

run_cargo_workspace_gate() {
  local workspace_manifest="$1"
  local gate_changed="$2"
  local gate_manifest_path="$gate_export/$workspace_manifest"
  local gate_command_cwd
  gate_command_cwd="$(dirname "$gate_manifest_path")"
  if [ ! -f "$gate_manifest_path" ]; then
    echo "pre-push: BLOCKED -- selected Cargo workspace manifest $workspace_manifest is missing from $gate_sha" >&2
    exit 1
  fi
  # Leading space: the steps render as `cargo doc --no-deps$gate_specs`, and
  # without it the flag joins the subcommand ("--no-deps--manifest-path").
  gate_manifest=" --manifest-path $gate_manifest_path"

  if [ "$stack_member" = "<meta>" ] \
    && printf '%s\n' "$gate_changed" | grep -qE '(^|/)Cargo\.(lock|toml)$'; then
    if [ ! -f "$checker" ]; then
      echo "pre-push: BLOCKED -- the stack lockfile checker is missing for $workspace_manifest" >&2
      exit 1
    elif ! (cd "$gate_command_cwd" \
      && "$python_bin" "$checker" --check --manifest-path "$gate_manifest_path"); then
      echo "pre-push: the lock for $workspace_manifest does not resolve under --locked on $gate_sha" >&2
      exit 1
    fi
  fi

# Packages with no target nextest can run (a `test = false` cdylib such as a
# PyO3 extension) produce no test artifact, so the source-identity checker would
# report "no artifact found" for a package the tests stage has nothing to build.
# Cargo metadata marks each target with `test`; a package none of whose targets
# has it is skipped by the tests stage only. Its clippy and rustdoc stages stay.
if ! untestable_packages="$(
  cd "$gate_command_cwd" && cargo metadata --no-deps --format-version 1 $gate_manifest |
    "$python_bin" -c 'import json, sys
sys.stdout.reconfigure(newline="\n")
metadata = json.load(sys.stdin)
members = set(metadata["workspace_members"])
for package in metadata["packages"]:
    targets = package.get("targets")
    if package["id"] in members and targets and not any(t.get("test", True) for t in targets):
        print(package["name"])'
)"; then
  echo "pre-push: cargo metadata could not establish testable packages" >&2
  echo "pre-push: push anyway with SKIP_LOCAL_GATE=1 git push" >&2
  exit 1
fi

# Cargo is the authority on which package manifests belong to this workspace.
# A nested standalone manifest (cargo-fuzz is the common case) can legally use
# the same package name as a member, so names alone cannot establish ownership.
# `--no-deps` reads membership without resolving dependencies or changing the
# lockfile. Each output record is `<repo-relative manifest><tab><package name>`.
if ! workspace_members="$(
  cd "$gate_command_cwd" && cargo metadata --no-deps --format-version 1 $gate_manifest |
    "$python_bin" -c 'import json, os, sys
# LF records: text-mode stdout on Windows writes CRLF, and bash keeps the CR
# in the package name, so a new-member push gated `helios-core<CR>` beside
# `helios-core` and the identity checker found no such package.
sys.stdout.reconfigure(newline="\n")
metadata = json.load(sys.stdin)
members = set(metadata["workspace_members"])
root = os.path.realpath(sys.argv[1])
for package in metadata["packages"]:
    if package["id"] not in members:
        continue
    manifest = os.path.realpath(package["manifest_path"])
    relative = os.path.relpath(manifest, root).replace(os.sep, "/")
    print(f"{relative}\t{package['"'"'name'"'"']}")' "$gate_command_cwd"
)"; then
  echo "pre-push: cargo metadata could not establish workspace membership" >&2
  echo "pre-push: push anyway with SKIP_LOCAL_GATE=1 git push" >&2
  exit 1
fi

# Changed paths -> the packages that own them. Ownership uses the nearest
# ancestor `[package]` manifest, then membership is checked against Cargo's
# workspace graph above. This includes committed fixtures: they are behavioral
# inputs to the owning package's tests even when no Rust source changed.
gate_packages=""
excluded_manifests=""
standalone_manifests=""
while IFS= read -r changed_path; do
  [ -n "$changed_path" ] || continue
  # Git hooks and CI definitions are input to no cargo invocation. Without
  # this, a single-package repository mapped them to its root package and a
  # hook-only push ran clippy, tests and rustdoc for the whole package.
  case "$changed_path" in
    .githooks/* | .github/*) continue ;;
  esac
  owner_dir="$(dirname "$changed_path")"
  package_dir=""
  excluded_manifest=""
  while [ "$owner_dir" != "." ] && [ "$owner_dir" != "/" ]; do
    manifest="$gate_command_cwd/$owner_dir/Cargo.toml"
    if [ -f "$manifest" ]; then
      if grep -qE '^\[package\]' "$manifest" 2>/dev/null; then
        package_dir="$owner_dir"
      elif grep -qE '^\[workspace\]' "$manifest" 2>/dev/null; then
        excluded_manifest="$owner_dir/Cargo.toml"
      fi
      break
    fi
    owner_dir="$(dirname "$owner_dir")"
  done
  if [ -n "$excluded_manifest" ]; then
    case " $excluded_manifests " in
      *" $excluded_manifest "*) ;;
      *) excluded_manifests="$excluded_manifests $excluded_manifest" ;;
    esac
    continue
  fi
  if [ -z "$package_dir" ] && [ "$changed_path" = "Cargo.toml" ] \
    && [ -f "$gate_manifest_path" ] \
    && grep -qE '^\[workspace\]' "$gate_manifest_path" 2>/dev/null; then
    while IFS=$'\t' read -r _workspace_manifest workspace_package; do
      [ -n "$workspace_package" ] || continue
      case " $gate_packages " in
        *" $workspace_package "*) ;;
        *) gate_packages="$gate_packages $workspace_package" ;;
      esac
    done <<< "$workspace_members"
    continue
  fi
  if [ -z "$package_dir" ]; then
    if [ -f "$gate_manifest_path" ] && grep -qE '^\[package\]' "$gate_manifest_path" 2>/dev/null; then
      package_dir="."
    else
      continue
    fi
  fi
  manifest="$gate_command_cwd/$package_dir/Cargo.toml"
  relative_manifest="${manifest#"$gate_command_cwd"/}"
  relative_manifest="${relative_manifest#./}"
  package_name="$(printf '%s\n' "$workspace_members" | awk -F '\t' -v manifest="$relative_manifest" '$1 == manifest { print $2; exit }')"
  if [ -z "$package_name" ]; then
    case " $standalone_manifests " in
      *" $relative_manifest "*) ;;
      *) standalone_manifests="$standalone_manifests $relative_manifest" ;;
    esac
    continue
  fi
  case " $gate_packages " in
    *" $package_name "*) ;;
    *) gate_packages="$gate_packages $package_name" ;;
  esac
done <<GATE_PATHS
$gate_changed
GATE_PATHS

if [ -n "${excluded_manifests// /}" ]; then
  cat >&2 <<MESSAGE

pre-push: changed files belong to a Cargo workspace excluded from the parent
workspace:$excluded_manifests

The parent gate cannot verify it with a parent-workspace -p argument. Run that
workspace's configured gate and commit its evidence, or push anyway with
SKIP_LOCAL_GATE=1 git push.
MESSAGE
  exit 1
fi

# Bare `as` casts are the one debt the lint table allows while the cast family
# burns down, so no other step fails on a new one. A registered member runs the
# stack's cast gate (scripts/atlas_cast_gate.py): the clippy runs below go
# through it, which adds `--force-warn clippy::as_conversions` with JSON output
# and records the cast sites, and `check` refuses a cast on a line the push
# adds, or a package count above its row in scripts/cast-baseline.json or above
# its count at the pushed range's base, measured with the same selection. A
# member reaches the stack scripts -- the conformance checker refuses the push
# above otherwise -- so a stack copy without the gate is refused like a missing
# identity checker: a gate that cannot judge never passes a push.
#
# This gate runs once per workspace, so the rows it records are globals
# (cast_check_packages, cast_check_sites, cast_base_sites): each workspace
# appends to them, and run_cast_check judges them once, in the tail, after
# every workspace has contributed.
if [ -n "$stack_member" ]; then
  cast_gate="${stack_scripts:+$stack_scripts/atlas_cast_gate.py}"
  if [ ! -f "$cast_gate" ] || [ -z "$python_bin" ]; then
    echo "pre-push: BLOCKED -- the stack's cast gate is missing at ${stack_baseline:0:12}." >&2
    exit 1
  fi
fi

# run_cast_check: judge the recorded sites against the pushed range.
run_cast_check() {
  [ -n "$cast_gate" ] && [ "${#cast_check_sites[@]}" -gt 0 ] || return 0
  local cast_status
  set +e
  "$python_bin" "$cast_gate" check --member "$stack_member" --repo "$repo_root" \
    --base "$gate_base" --tip "$gate_sha" "${cast_check_packages[@]}" "${cast_check_sites[@]}" \
    ${cast_base_sites[@]+"${cast_base_sites[@]}"} >&2
  cast_status=$?
  set -e
  if [ "$cast_status" -eq 1 ]; then
    cat >&2 <<MESSAGE

pre-push: BLOCKED -- a bare \`as\` cast. Convert through std's form where one
exists (From/TryFrom, cast_signed/cast_unsigned, to_bits/from_bits) or
through eunomia's conversion module (FloatElement::from_count/from_integer,
TryFromCount); never annotate the cast. Rows of scripts/cast-baseline.json
in atlas only fall.
MESSAGE
    exit 1
  elif [ "$cast_status" -ne 0 ]; then
    echo "pre-push: BLOCKED -- the cast gate could not run (exit $cast_status)." >&2
    exit 1
  fi
}

# A standalone crate outside the parent workspace (cargo-fuzz is the common
# case) cannot be named by a parent-workspace `-p`, and its targets need a
# toolchain this host may lack (nightly, sanitizers), so its compile and run
# verification stays with CI. What every host can establish is checked here:
# its own lockfile resolves under `--locked` and its sources are
# rustfmt-clean. Refusing the push instead left no way to change a fuzz
# target at all. A nested virtual workspace, whose members deserve a real
# gate, is still refused above.
for standalone_manifest in $standalone_manifests; do
  if ! (cd "$gate_command_cwd" && cargo metadata --locked --no-deps --format-version 1 \
    --manifest-path "$gate_command_cwd/$standalone_manifest" >/dev/null 2>&1); then
    cat >&2 <<MESSAGE

pre-push: the lockfile of the standalone crate $standalone_manifest does not
resolve under --locked on $gate_sha.

From a checkout of $gate_sha outside the stack overlay:

    cargo metadata --locked --no-deps --manifest-path $standalone_manifest

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
    exit 1
  fi
  if ! (cd "$gate_command_cwd" && cargo fmt --manifest-path "$gate_command_cwd/$standalone_manifest" -- --check >/dev/null); then
    cat >&2 <<MESSAGE

pre-push: \`cargo fmt --check\` fails for the standalone crate $standalone_manifest on $gate_sha.

Run \`cargo fmt --manifest-path $standalone_manifest\` and commit the result. To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
    exit 1
  fi
  echo "pre-push: standalone crate $standalone_manifest: lockfile and formatting checked; CI builds it" >&2
done

# A push changing only standalone crates still has their casts to judge,
# below, under the identity leases; one changing nothing cargo builds ends here.
if [ -z "${gate_packages// /}" ] && { [ -z "$cast_gate" ] || [ -z "${standalone_manifests// /}" ]; }; then
  echo "pre-push: no package owns the changed files in $workspace_manifest; local gate not needed" >&2
  return 0
fi

# Run one gate step and say whose failure it was.
#
# The step resolves the committed lock outside the overlay. When that graph is
# broken -- a first-party git source CI cannot fetch either, or a lock that
# does not resolve under `--locked` -- the step fails on a crate under
# `~/.cargo`, nowhere near the push. Reporting that as "your clippy fails" is
# how a gate loses its credibility and starts getting bypassed.
#
# The verdict defaults to 'ours' and only an affirmative case moves it. A
# failing test emits no compile diagnostics at all, so "found nothing outside
# the repository" must not be read as "the environment did it" -- that reading
# passed a deliberately failing test during probing, which is the exact defect
# this gate exists to prevent. Blame the change unless the evidence positively
# says otherwise.
#
# Echoes 'ours', 'environment', or 'ok'.
normalise_diagnostic_path() {
  local value="$1"
  value="$(printf '%s' "$value" | tr 'A-Z\' 'a-z/' 2>/dev/null)"

  # Git Bash can expose the repository through its long path while cargo's
  # diagnostics use an equivalent DOS 8.3 path (for example, RYANCL~1). Use
  # one Windows spelling for both sides when cygpath is available; POSIX
  # runners retain the normalized slash form above.
  if command -v cygpath >/dev/null 2>&1; then
    case "$value" in
      [a-z]:/*|/*)
        local short_value
        if short_value="$(cygpath -m -s "$value" 2>/dev/null)"; then
          # cygpath spells the drive letter upper case; the classifier's
          # drive-path case is lower case, as the first pass left it.
          value="$(printf '%s' "$short_value" | tr 'A-Z' 'a-z')"
        fi
        ;;
    esac
  fi
  printf '%s' "$value"
}

classify_gate_step() {
  local log="$1"
  shift
  # A step over another tree -- the pushed range's base, or a standalone
  # crate's own workspace -- names its directory and package selection;
  # the defaults are this workspace's export and its gate packages.
  local step_directory="${step_root:-$gate_export}"
  local step_names="${step_selection-$gate_packages}"
  if (cd "$step_directory" && "$@" >"$log" 2>&1); then
    echo ok
    return 0
  fi

  # Two workspaces defining one package is a `[patch]` overlay reaching the
  # export, never the change: see where the export is built.
  if grep -q 'package collision in the lockfile' "$log"; then
    echo environment
    return 0
  fi

  if grep -q 'cargo metadata failed' "$log" \
    && grep -q -- '--locked' "$log"; then
    echo environment
    return 0
  fi

  if ! grep -q 'command failed with exit code' "$log" \
    && grep -q 'atlas-build-identity:' "$log"; then
    echo identity
    return 0
  fi

  local root_normalised inside=0 outside=0 location foreign_crate=0
  root_normalised="$(normalise_diagnostic_path "$step_directory")"

  # Only locations under an `error` header count. A crate that fails to compile
  # still emits warnings for whatever did compile, and counting those made the
  # verdict depend on what the build cache happened to hold.
  #
  # Deduplication is awk, not `sort -u`: on Windows developer machines `sort`
  # can resolve to the System32 SORT.EXE, which rejects `-u` and empties the
  # pipeline -- every verdict then degrades to 'ours'.
  while IFS= read -r location; do
    [ -n "$location" ] || continue
    location="$(normalise_diagnostic_path "$location")"
    case "$location" in
      /*|[a-z]:/*)
        case "$location" in
          "$root_normalised"/*) inside=$((inside + 1)) ;;
          *) outside=$((outside + 1)) ;;
        esac
        ;;
      *) inside=$((inside + 1)) ;;
    esac
  done <<DIAGNOSTICS
$(awk '/^error/ { under_error = 1; next } /^warning/ { under_error = 0; next } under_error && /^[[:space:]]*--> / { sub(/^[[:space:]]*--> /, ""); sub(/:[0-9]+:[0-9]+$/, ""); if (!seen[$0]++) print }' "$log")
DIAGNOSTICS

  # A cached rebuild can report `could not compile` without re-emitting the
  # diagnostic that explains it, so the failing crate's name is a second
  # witness: one that is not being gated is not this push's.
  local failed_crate
  while IFS= read -r failed_crate; do
    [ -n "$failed_crate" ] || continue
    case " $step_names " in
      *" $failed_crate "*) ;;
      *) foreign_crate=$((foreign_crate + 1)) ;;
    esac
  done <<CRATES
$(sed -n 's/^error: could not compile `\([^`]*\)`.*/\1/p' "$log" | awk '!seen[$0]++')
CRATES

  if [ "$inside" -eq 0 ] && { [ "$outside" -gt 0 ] || [ "$foreign_crate" -gt 0 ]; }; then
    echo environment
  else
    echo ours
  fi
}

report_broken_graph() {
  local step="$1" log="$2"
  cat >&2 <<MESSAGE

pre-push: the $step step failed, but every diagnostic points outside this
repository, so the local dependency graph is broken rather than this change.
That is usually the committed lock: a git source this machine cannot fetch,
or a lock that no longer resolves under --locked.

The gate could not run, so this push is NOT verified. First diagnostic:

MESSAGE
  grep -m 1 -A 3 -E '^error' "$log" >&2 || true
  cat >&2 <<'MESSAGE'

Check with `python3 <stack>/scripts/lockfile.py --check --manifest-path Cargo.toml` in the member.
MESSAGE
}

gate_package_specs=""
for package_name in $gate_packages; do
  gate_package_specs="$gate_package_specs -p $package_name"
done
gate_specs="$gate_manifest$gate_package_specs --locked"
gate_reproduce="From a checkout of $gate_sha outside the stack overlay:"

identity_scripts="${prepared_stack_scripts:-$stack_scripts}"
identity_checker="${identity_scripts:+$identity_scripts/atlas-build-identity.py}"
identity_target_dir=""
identity_target="${CARGO_BUILD_TARGET:-host}"
identity_enabled=0
if [ -f "$identity_checker" ]; then
  if [ -z "$python_bin" ]; then
    echo "pre-push: source identity checker is present but no python interpreter found" >&2
    exit 1
  fi
  if ! identity_target_dir="$(
    cd "$gate_command_cwd" && cargo metadata --no-deps --format-version 1 $gate_manifest |
      "$python_bin" -c 'import json, sys
value = json.load(sys.stdin).get("target_directory")
if not isinstance(value, str) or not value:
    raise SystemExit("cargo metadata did not provide target_directory")
print(value)'
  )"; then
    echo "pre-push: cargo metadata did not provide the shared target directory" >&2
    exit 1
  fi
  identity_enabled=1
elif [ -n "$stack_member" ]; then
  echo "pre-push: BLOCKED -- the stack source identity checker is missing" >&2
  exit 1
else
  echo "pre-push: source identity checker not reachable from this clone; CI enforces it" >&2
fi

# The source-identity checker executes this complete sequence as one command,
# so its package leases stay held from clippy through rustdoc and the final
# source/dependency checks. Releasing them between stages allowed a peer to
# replace the shared artifacts after clippy or tests had accepted them.
#
# A step over another tree -- normally this workspace's export -- sets
# step_root, step_manifest, step_selection and step_key for its call, and
# step_ours=return makes a failure of its own a status of 3 for the caller to
# handle instead of a refusal; the defaults are this workspace's values.
# With the cast gate in play the clippy stage runs through it, which records
# this selection's cast sites beside the build.
run_identity_sequence() {
  local run_tests="$1" run_rustdoc="$2" stage_file="$3"
  local root="${step_root:-$gate_export}"
  local manifest="${step_manifest:-$gate_manifest_path}"
  local chosen="${step_selection-$gate_packages}"
  local manifest_relative="${manifest#"$root"/}"
  local command_cwd
  command_cwd="$(dirname "$manifest")"
  local package_name package_arguments=() selection_arguments=() selection=()
  for package_name in $chosen; do
    package_arguments+=(--package "$package_name")
    selection_arguments+=(--selection "$package_name")
    selection+=(-p "$package_name")
  done
  local identity_command
  identity_command=(
    "$python_bin" "$identity_checker" run
    --root "$root"
    "${package_arguments[@]}"
    "${selection_arguments[@]}"
    --target-dir "$identity_target_dir"
    --profile debug
    --target "$identity_target"
    --manifest "$manifest"
    --command-cwd "$command_cwd"
    --command-key "${step_key:-atlas-pre-push}"
    --
    bash -c '
stage_file="$1"
manifest="$2"
run_tests="$3"
run_rustdoc="$4"
command_root="$5"
cast_python="$6"
cast_gate="$7"
cast_sites="$8"
manifest_relative="$9"
shift 9
cargo_command="${CARGO:-cargo}"
printf "%s\n" clippy >"$stage_file"
if [ -n "$cast_gate" ]; then
  "$cast_python" "$cast_gate" clippy --export "$command_root" --manifest "$manifest_relative" --sites "$cast_sites" "$@" || exit $?
else
  "$cargo_command" clippy --manifest-path "$manifest" --all-targets --locked "$@" || exit $?
fi
if [ "$run_tests" = 1 ]; then
  printf "%s\n" tests >"$stage_file"
  "$cargo_command" nextest run --manifest-path "$manifest" --locked --no-tests=pass "$@" || exit $?
fi
if [ "$run_rustdoc" = 1 ]; then
  printf "%s\n" rustdoc >"$stage_file"
  env RUSTDOCFLAGS="-D warnings" "$cargo_command" doc --no-deps --manifest-path "$manifest" --locked "$@" || exit $?
fi
printf "%s\n" verification >"$stage_file"
' atlas-pre-push-sequence "$stage_file" "$manifest" "$run_tests" "$run_rustdoc" \
    "$root" "$python_bin" "${cast_gate:-}" "${cast_sites:-}" "$manifest_relative"
    "${selection[@]}"
  )
  local verdict step_name
  verdict="$(classify_gate_step "$gate_log" "${identity_command[@]}")"
  step_name="$(cat "$stage_file" 2>/dev/null || true)"
  [ -n "$step_name" ] || step_name="source identity sequence"
  case "$verdict" in
    ok) ;;
    identity)
      cat >&2 <<MESSAGE

pre-push: source identity blocked $step_name for$gate_packages; no artifact was accepted.
MESSAGE
      grep -m 1 'atlas-build-identity:' "$gate_log" >&2 || true
      exit 1
      ;;
    ours)
      [ "${step_ours:-}" = return ] && return 3
      cat >&2 <<MESSAGE

pre-push: $step_name fails for$gate_packages, so the source-identity build did not complete.
MESSAGE
      grep -m 1 '^error' "$gate_log" >&2 || true
      exit 1
      ;;
    environment)
      report_broken_graph "source identity $step_name" "$gate_log"
      echo "pre-push: source identity did not verify the pushed revision" >&2
      exit 1
      ;;
  esac
}

# Cast sites for the count against the base, which runs first: base and tip
# share unit hashes, so whichever builds last owns those artifacts, and the
# tip's steps then reuse its own. The base costs one more build of the pushed
# packages, so it runs only when the range can bring existing casts into a
# pushed package without adding their lines (`base-triggers`: a rename, or a
# manifest, package-root build script, cargo config or toolchain pin change).
# A manifest whose base fails to compile leaves its own packages to their
# rows, said on the push: a push must still be able to fix a broken default
# branch. Any other base failure refuses, since the gate could not judge. A
# package the base lacks counts zero; new history has no base and is held to
# the rows.

# package_names <manifest>: the workspace package names of <manifest>.
package_names() {
  (cd "$(dirname "$1")" && cargo metadata --no-deps --format-version 1 --manifest-path "$1") |
    "$python_bin" -c 'import json, sys
sys.stdout.reconfigure(newline="\n")
print("\n".join(sorted(p["name"] for p in json.load(sys.stdin)["packages"])))'
}

# base_does_not_compile <log> <packages>: cargo reports one of the base's own
# packages failing on diagnostics rustc emitted (`due to N previous error`: a
# rustc error or a denied lint), and nothing else: no gate error; no compiler
# that exited abnormally -- killed (exit 1 under `taskkill`, a signal), out of
# memory, crashed, silent (exit 101 on a full disk), or panicked (an internal
# compiler error), each of which cargo reports with `Caused by: process didn't
# exit successfully`; and no unreadable or mismatched crate metadata
# (E0460-E0464, E0514, E0519, E0786), which is a broken artifact in the shared
# target rather than the base's source.
base_does_not_compile() {
  local log="$1" package_name compiled=1
  for package_name in $2; do
    grep -q -E "^error: could not compile \`$package_name\` .*due to [0-9]+ previous error" "$log" \
      && compiled=0
  done
  [ "$compiled" -eq 0 ] \
    && ! grep -q -E "^cast gate:|memory allocation of|exit code: 0xc|didn't exit successfully|panicked|internal compiler error" "$log" \
    && ! grep -q -E '^error\[E(046[0-4]|0514|0519|0786)\]' "$log"
}

# run_identity_clippy <step name> <packages> <command...>: one leased clippy
# run over step_root (default: this export) with step_manifest, step_selection
# and step_key naming its tree and selection -- the base's clippy and a
# standalone crate's, each under the source-identity checker's lease. A failure
# classified as this machine's own returns 3 when step_ours=return, for
# cast_base_step to judge against cargo's summary; anything else refuses here,
# since a cast gate that cannot judge never passes a push.
run_identity_clippy() {
  local step_name="$1" packages="$2"
  shift 2
  local root="${step_root:-$gate_export}"
  local manifest="${step_manifest:-$root/Cargo.toml}"
  local chosen="${step_selection-$gate_packages}"
  local package_name package_arguments=() selection_arguments=() selection=()
  for package_name in $packages; do
    package_arguments+=(--package "$package_name")
  done
  [ "${#package_arguments[@]}" -gt 0 ] || return 0
  for package_name in $chosen; do
    selection_arguments+=(--selection "$package_name")
    selection+=(-p "$package_name")
  done
  local identity_command
  identity_command=(
    "$python_bin" "$identity_checker" run
    --root "$root"
    "${package_arguments[@]}"
    "${selection_arguments[@]}"
    --target-dir "$identity_target_dir"
    --profile debug
    --target "$identity_target"
    --manifest "$manifest"
    --command-cwd "$root"
    --command-key "${step_key:-atlas-pre-push}"
    --
    "$@"
    "${selection[@]}"
  )
  local verdict
  verdict="$(classify_gate_step "$gate_log" "${identity_command[@]}")"
  case "$verdict" in
    ok) ;;
    identity)
      cat >&2 <<MESSAGE

pre-push: source identity blocked $step_name for$packages; no artifact was accepted.
MESSAGE
      grep -m 1 'atlas-build-identity:' "$gate_log" >&2 || true
      exit 1
      ;;
    ours)
      [ "${step_ours:-}" = return ] && return 3
      cat >&2 <<MESSAGE

pre-push: $step_name fails for$packages, so the source-identity build did not complete.
MESSAGE
      grep -m 1 -E '^(error|cast gate:)' "$gate_log" >&2 || true
      exit 1
      ;;
    environment)
      report_broken_graph "source identity $step_name" "$gate_log"
      echo "pre-push: source identity did not verify the pushed revision" >&2
      exit 1
      ;;
  esac
}

# cast_base_step <manifest-relative> <packages>: the base's sites for those
# packages, which then join the base comparison.
cast_base_step() {
  local relative="$1" wanted="$2" present="" package_name names sites
  [ -n "$base_export" ] || return 0
  sites="$(mktemp "$tmp_base/pg-casts.XXXXXX")"
  run_temps+=("$sites")
  printf '[]' > "$sites"
  if [ -f "$base_export/$relative" ]; then
    names="$(package_names "$base_export/$relative" | tr -d '\r')" || {
      echo "pre-push: BLOCKED -- cargo metadata fails for $relative at the pushed base ${gate_base:0:12}, so the cast gate cannot judge it." >&2
      exit 1
    }
    for package_name in $wanted; do
      case $'\n'"$names"$'\n' in
        *$'\n'"$package_name"$'\n'*) present="$present $package_name" ;;
      esac
    done
  fi
  if [ -n "${present// /}" ]; then
    local status=0
    step_root="$base_export" step_manifest="$base_export/$relative" step_selection="$present" \
      step_key="atlas-pre-push-casts-base" step_ours=return \
      run_identity_clippy "base clippy" "$present" "$python_bin" "$cast_gate" clippy \
        --export "$base_export" --manifest "$relative" --sites "$sites" --present-only \
      || status=$?
    if [ "$status" -ne 0 ]; then
      if base_does_not_compile "$gate_log" "$present"; then
        echo "pre-push: $relative does not compile at the pushed base ${gate_base:0:12}, so its packages' cast counts are held to their rows alone" >&2
        return 0
      fi
      cat >&2 <<MESSAGE

pre-push: BLOCKED -- the cast gate's clippy run fails for $relative at the
pushed base ${gate_base:0:12} for a reason other than a compile error, so the
cast gate cannot judge it.
MESSAGE
      grep -m 3 -E '^(error|cast gate:)' "$gate_log" >&2 || true
      exit 1
    fi
  fi
  cast_base_sites+=(--base-sites "$sites")
  for package_name in $wanted; do
    cast_base_sites+=(--base-package "$package_name")
  done
}

if [ -n "$cast_gate" ]; then
  # The cast steps classify against their own log, taken before the workspace
  # steps take theirs below.
  gate_log="$(mktemp "$tmp_base/pg-log.XXXXXX")"
  run_temps+=("$gate_log")
  base_reasons=""
  if [ -n "$gate_base" ]; then
    base_reasons="$("$python_bin" "$cast_gate" base-triggers --repo "$repo_root" \
      --base "$gate_base" --tip "$gate_sha" | tr -d '\r')" || {
      echo "pre-push: BLOCKED -- the cast gate could not read the pushed range ${gate_base:0:12}..${gate_sha:0:12}" >&2
      exit 1
    }
  fi
  # One base export serves every workspace of this push.
  if [ -n "$base_reasons" ] && [ -z "$base_export" ]; then
    echo "pre-push: cast counts are compared with the pushed base (${base_reasons%%$'\n'*})" >&2
    base_export="$gate_parent/base-${repo_root##*/}"
    mkdir -p "$base_export"
    base_export="$(cd "$base_export" && { pwd -W 2>/dev/null || pwd; })"
    if ! export_revision "$gate_base" "$base_export"; then
      rm -rf "$base_export" && mkdir -p "$base_export"
      if ! export_revision "$gate_base" "$base_export"; then
        echo "pre-push: BLOCKED -- could not export the pushed base $gate_base for the cast gate" >&2
        exit 1
      fi
    fi
  fi
  if [ -n "${gate_packages// /}" ]; then
    cast_base_step Cargo.toml "$gate_packages"
  fi
  for standalone_manifest in $standalone_manifests; do
    standalone_names="$(package_names "$gate_export/$standalone_manifest" | tr -d '\r')" || {
      echo "pre-push: BLOCKED -- cargo metadata fails for the standalone crate $standalone_manifest, so the cast gate cannot judge it." >&2
      exit 1
    }
    cast_base_step "$standalone_manifest" "$standalone_names"
    standalone_sites="$(mktemp "$tmp_base/pg-casts.XXXXXX")"
    run_temps+=("$standalone_sites")
    standalone_status=0
    step_manifest="$gate_export/$standalone_manifest" step_selection="$standalone_names" \
      step_key="atlas-pre-push-casts-standalone" step_ours=return \
      run_identity_clippy "standalone clippy" "$standalone_names" "$python_bin" "$cast_gate" clippy \
        --export "$gate_export" --manifest "$standalone_manifest" --sites "$standalone_sites" \
      || standalone_status=$?
    if [ "$standalone_status" -ne 0 ]; then
      cat >&2 <<MESSAGE

pre-push: BLOCKED -- clippy does not complete for the standalone crate
$standalone_manifest on $gate_sha, so the cast gate cannot judge it.
MESSAGE
      grep -m 3 -E '^(error|cast gate:)' "$gate_log" >&2 || true
      exit 1
    fi
    for package_name in $standalone_names; do
      cast_check_packages+=(--package "$package_name")
    done
    cast_check_sites+=(--sites "$standalone_sites")
  done
fi

# A push whose changed files belong only to standalone crates has judged their
# casts; the workspace steps below have nothing to build. run_cast_check runs
# once, in the tail, over every row this push recorded.
if [ -z "${gate_packages// /}" ]; then
  echo "pre-push: no workspace package owns the changed files; standalone crates checked" >&2
  return 0
fi

echo "pre-push: gating${gate_packages}" >&2

# Formatting is workspace-wide and near-instant, and its failure is the
# cheapest one to find here rather than on a runner.
if ! (cd "$gate_command_cwd" && cargo fmt --all $gate_manifest -- --check >/dev/null); then
  cat >&2 <<MESSAGE

pre-push: \`cargo fmt --check\` fails on $gate_sha, so the architecture validation would.

Run \`cargo fmt\` and commit the result. To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
  exit 1
fi

# The SAFETY ratchet is a member-owned, whole-repository text scan that CI's
# workspace job runs after the checks above. apollo#397 passed this gate and
# then failed CI on a `// SAFETY:` comment two lines above its block, because
# nothing here ran the ratchet. It is text-only and fast, so it runs before the
# compile steps; a member without the script has no ratchet to run.
safety_ratchet="$gate_command_cwd/scripts/safety_ratchet.py"
if [ -f "$safety_ratchet" ]; then
  if [ -z "$python_bin" ]; then
    echo "pre-push: scripts/safety_ratchet.py present but no python interpreter found" >&2
    echo "pre-push: push anyway with SKIP_LOCAL_GATE=1 git push" >&2
    exit 1
  fi
  if ! (cd "$gate_command_cwd" && "$python_bin" "$safety_ratchet" check >&2); then
    cat >&2 <<'MESSAGE'

pre-push: the SAFETY ratchet fails, so CI's workspace job would. Put a
`// SAFETY:` comment directly above each new `unsafe {` block, stating the
obligation it discharges.

Reproduce:

    python scripts/safety_ratchet.py check

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
    exit 1
  fi
fi

# The workspace lint table denies what matters, so this gate runs clippy
# without extra flags: adding `-D warnings` here would fail on the
# pre-existing per-crate debt the ratchet exists to burn down, and a gate
# that fails on debt you did not write is a gate that gets bypassed.
gate_log="$(mktemp "$tmp_base/pg-log.XXXXXX")"
run_temps+=("$gate_log")

if [ "$identity_enabled" -eq 1 ]; then
  run_tests=0
  if command -v cargo-nextest >/dev/null 2>&1; then
    testable_packages=""
    for package_name in $gate_packages; do
      case $'\n'"$untestable_packages"$'\n' in
        *$'\n'"$package_name"$'\n'*) continue ;;
      esac
      testable_packages="$testable_packages $package_name"
    done
    [ -z "${testable_packages// /}" ] || run_tests=1
  else
    echo "pre-push: cargo-nextest not installed; tests not run" >&2
  fi

  # `cargo doc` writes an artifact only for a package with a documented lib or
  # bin target. A bench-only package (moirai-benchmarks) or a `[lib] doc =
  # false` one (consus-python) writes none, so an all-undocumented selection
  # skips the stage; cargo's own target list is the authority.
  if ! documented_packages="$(
    cd "$gate_command_cwd" && cargo metadata --no-deps --format-version 1 $gate_manifest |
      "$python_bin" -c 'import json, sys
sys.stdout.reconfigure(newline="\n")
documented = {"lib", "rlib", "dylib", "cdylib", "staticlib", "proc-macro", "bin"}
for package in json.load(sys.stdin)["packages"]:
    targets = package.get("targets")
    if targets is None or any(
        target.get("doc", True) and documented.intersection(target["kind"])
        for target in targets
    ):
        print(package["name"])'
  )"; then
    echo "pre-push: cargo metadata did not list the documented packages" >&2
    exit 1
  fi
  rustdoc_packages=""
  for package_name in $gate_packages; do
    case "
$documented_packages
" in
      *"
$package_name
"*) rustdoc_packages="$rustdoc_packages $package_name" ;;
      *) echo "pre-push: rustdoc skipped for $package_name; it has no documented lib or bin target" >&2 ;;
    esac
  done
  run_rustdoc=0
  [ -z "${rustdoc_packages// /}" ] || run_rustdoc=1

  gate_stage="$(mktemp "$tmp_base/pg-stage.XXXXXX")"
  run_temps+=("$gate_stage")
  # With the cast gate in play, the sequence's clippy stage records this
  # workspace's tip sites; they join the rows run_cast_check judges once,
  # after every workspace has contributed.
  cast_sites=""
  if [ -n "$cast_gate" ]; then
    cast_sites="$(mktemp "$tmp_base/pg-casts.XXXXXX")"
    run_temps+=("$cast_sites")
  fi
  run_identity_sequence "$run_tests" "$run_rustdoc" "$gate_stage"
  if [ -n "$cast_gate" ]; then
    cast_check_sites+=(--sites "$cast_sites")
    for package_name in $gate_packages; do
      cast_check_packages+=(--package "$package_name")
    done
  fi
else
  case "$(classify_gate_step "$gate_log" cargo clippy $gate_specs --all-targets)" in
    ours)
      cat >&2 <<MESSAGE

pre-push: clippy fails for$gate_packages, so the CI ratchet would.

$gate_reproduce

    cargo clippy$gate_package_specs --all-targets --locked

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
      exit 1
      ;;
    environment)
      report_broken_graph clippy "$gate_log"
      exit 0
      ;;
  esac
fi

if [ "$identity_enabled" -eq 0 ]; then
  if command -v cargo-nextest >/dev/null 2>&1; then
    case "$(classify_gate_step "$gate_log" cargo nextest run $gate_specs --no-tests=pass)" in
      ours)
        cat >&2 <<MESSAGE

pre-push: tests fail for$gate_packages.

$gate_reproduce

    cargo nextest run$gate_package_specs --locked --no-tests=pass

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
        exit 1
        ;;
      environment)
        report_broken_graph test "$gate_log"
        exit 0
        ;;
    esac
  else
    echo "pre-push: cargo-nextest not installed; tests not run" >&2
  fi
fi

# CI documents every package with `RUSTDOCFLAGS=-D warnings`, so a broken or
# redundant intra-doc link that clippy and the tests never see turns main red
# after the merge (a redundant link target from apollo#508 did). The changed
# packages are documented here the same way.
if [ "$identity_enabled" -eq 0 ]; then
  case "$(classify_gate_step "$gate_log" env RUSTDOCFLAGS="-D warnings" cargo doc --no-deps $gate_specs)" in
    ours)
      cat >&2 <<MESSAGE

pre-push: rustdoc fails for$gate_packages, so the CI rustdoc shard would.

$gate_reproduce

    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps$gate_package_specs --locked

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
      exit 1
      ;;
    environment)
      report_broken_graph rustdoc "$gate_log"
      exit 0
      ;;
  esac
fi

echo "pre-push: local gate passed" >&2
}

select_meta_cargo_owners() {
  local changed_file="$1" base_manifests="$2" candidate_manifests="$3" output="$4"
  "$python_bin" - "$changed_file" "$base_manifests" "$candidate_manifests" "$output" <<'PY'
import pathlib
import sys

changed = pathlib.Path(sys.argv[1]).read_text(encoding="utf-8").splitlines()
base = set(pathlib.Path(sys.argv[2]).read_text(encoding="utf-8").splitlines())
candidate = set(pathlib.Path(sys.argv[3]).read_text(encoding="utf-8").splitlines())
all_manifests = base | candidate
selected = {}

def owner(path):
    directory = pathlib.PurePosixPath(path).parent
    while directory != pathlib.PurePosixPath("."):
        manifest = (directory / "Cargo.toml").as_posix()
        if manifest in all_manifests:
            return manifest
        directory = directory.parent
    return None

global_inputs = {
    "rust-toolchain",
    "rust-toolchain.toml",
    ".config/nextest.toml",
}
for path in changed:
    if not path:
        continue
    if path in {"Cargo.toml", "Cargo.lock"}:
        raise SystemExit(f"the Atlas meta root cannot own {path}; Cargo workspaces live below tools/")
    if path in global_inputs or path.startswith(".cargo/"):
        for manifest in candidate:
            selected.setdefault(manifest, set()).add("Cargo.toml")
        continue
    manifest = owner(path)
    if manifest is None:
        continue
    if manifest not in candidate:
        raise SystemExit(f"selected Cargo workspace manifest {manifest} is missing from the pushed revision")
    root = pathlib.PurePosixPath(manifest).parent
    relative = pathlib.PurePosixPath(path).relative_to(root).as_posix()
    selected.setdefault(manifest, set()).add(relative)

with pathlib.Path(sys.argv[4]).open("w", encoding="utf-8", newline="\n") as stream:
    for manifest in sorted(selected):
        for path in sorted(selected[manifest]):
            stream.write(f"{manifest}\t{path}\n")
PY
}

# The per-workspace cast rows are globals: they accumulate across the calls
# below, and run_cast_check judges them once, after every workspace has
# contributed. base_export is one base tree for the whole push.
cast_gate=""
base_export=""
cast_check_packages=()
cast_check_sites=()
cast_base_sites=()
if [ "$stack_member" = "<meta>" ]; then
  meta_changed="$(mktemp "$tmp_base/pg-meta-changed.XXXXXX")"
  meta_base_manifests="$(mktemp "$tmp_base/pg-meta-base.XXXXXX")"
  meta_candidate_manifests="$(mktemp "$tmp_base/pg-meta-candidate.XXXXXX")"
  meta_owners="$(mktemp "$tmp_base/pg-meta-owners.XXXXXX")"
  run_temps+=("$meta_changed" "$meta_base_manifests" "$meta_candidate_manifests" "$meta_owners")
  printf '%s\n' "$gate_changed" > "$meta_changed"
  : > "$meta_base_manifests"
  if [ -n "$gate_base" ]; then
    if ! git ls-tree -r --name-only "$gate_base" -- tools \
      | awk '/^tools\/.+\/Cargo\.toml$/ { print }' > "$meta_base_manifests"; then
      echo "pre-push: BLOCKED -- could not inspect the base Cargo workspace owners" >&2
      exit 1
    fi
  fi
  if ! git ls-tree -r --name-only "$gate_sha" -- tools \
    | awk '/^tools\/.+\/Cargo\.toml$/ { print }' > "$meta_candidate_manifests"; then
    echo "pre-push: BLOCKED -- could not inspect the pushed Cargo workspace owners" >&2
    exit 1
  fi
  if ! select_meta_cargo_owners \
    "$meta_changed" "$meta_base_manifests" "$meta_candidate_manifests" "$meta_owners"; then
    echo "pre-push: BLOCKED -- could not select the Atlas meta root's Cargo workspace owners" >&2
    exit 1
  fi
  if [ ! -s "$meta_owners" ]; then
    echo "pre-push: no nested Cargo workspace owns the changed files; native gate not applicable" >&2
    exit 0
  fi
  while IFS= read -r workspace_manifest; do
    [ -n "$workspace_manifest" ] || continue
    workspace_changed="$(awk -F '\t' -v manifest="$workspace_manifest" '$1 == manifest { print $2 }' "$meta_owners")"
    run_cargo_workspace_gate "$workspace_manifest" "$workspace_changed"
  done < <(awk -F '\t' '!seen[$1]++ { print $1 }' "$meta_owners")
else
  run_cargo_workspace_gate "Cargo.toml" "$gate_changed"
fi

# The gate ran every workspace; the recorded cast sites are judged as one
# range, once, whether the push carried workspace packages, standalone crates,
# or both.
run_cast_check
