#!/usr/bin/env bash
#
# Atlas member-side pre-push gate (single owned copy; see below).
#
# Guards, in order: the lockfile must resolve under `--locked`; the pushed
# range must stay within the artifact budgets, add no credential, and raise no
# debt class above the member's recorded baseline; and the packages the push
# changes must pass fmt, clippy, and their tests. CI confirms what this found;
# it should not be where a defect is discovered.
#
# Refuse a push whose Cargo.lock cannot resolve under `--locked`.
#
# A member is normally worked on inside the Atlas stack, whose
# `.cargo/config.toml` carries a `[patch]` overlay redirecting every first-party
# dependency to a local working tree. Cargo finds that config by walking up from
# the current directory, so *any* cargo command run from inside the stack -- a
# test run, a check, a build -- rewrites `Cargo.lock` with every
# `source = "git+..."` line stripped. That lock resolves perfectly under the
# same overlay, which is why local verification never sees the problem, and
# fails every `--locked` job in CI, which has no overlay.
#
# `scripts/lockfile.py --check` runs cargo from outside the overlay and is the
# same check CI runs, so a push that would fail there never reaches a runner.
#
# Single source: this file is owned here and deployed outward to every
# member's `.githooks/` by `scripts/atlas-lock-form.py sync-hooks`
# (`--check` reports drift, which is what CI runs). Do not hand-edit member
# copies; change this file and re-sync. A member copy that differs from this
# file is drift, counted by the conformance `member_gate_versions` class.
#
# Install (git does not apply tracked hooks on its own):
#
#     python scripts/atlas-lock-form.py install-hooks
#
# Bypass deliberately:
#
#     SKIP_LOCAL_GATE=1 git push       (fast gate section only)
#
# SKIP_LOCKFILE_CHECK is not honoured: a lock check that fails, or cannot
# run, refuses the push either way. coeus's checker contract (scripts/tests/
# test_hooks.py::test_skip_variable_cannot_hide_checker_failures) requires
# that no variable can hide a checker failure, and this hook's own skip used
# to exit 0 on an absent checker or interpreter -- hiding a failure exactly
# as completely as a failure would. The accepted cost: an offline push with a
# cold cargo cache now fails loudly instead of passing unverified.
set -euo pipefail

# The lockfile section below still runs unconditionally; only the
# no-manifest-in-range skip further down (evidence, not a bypass) can
# shorten it.
skip_lockfile=0
if [ "${SKIP_LOCKFILE_CHECK:-0}" = "1" ]; then
  echo "pre-push: SKIP_LOCKFILE_CHECK is no longer honoured; running the lockfile check anyway" >&2
fi

# A managed worktree may be owned by a different filesystem account than the
# process pushing from it, and git does not propagate command-line config into
# hooks. Re-inject the checkout path so child git calls stay valid.
repo_root="$(git -c safe.directory="$PWD" rev-parse --show-toplevel)"
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0="$repo_root"

# The remote's default branch is whatever the remote says it is: `origin/HEAD`
# follows a rename, `origin/main` does not (hephaestus defaults to `master`).
# Echoes the merge-base of `$1` with that branch, or nothing when neither
# ref resolves.
default_branch_base() {
  local tip="$1" ref ref_sha base
  for ref in origin/HEAD origin/main; do
    ref_sha="$(git rev-parse --verify --quiet "$ref" 2>/dev/null || true)"
    [ -n "$ref_sha" ] || continue
    base="$(git merge-base "$ref_sha" "$tip" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      printf '%s' "$base"
      return 0
    fi
  done
  return 1
}

# The check measures the *working tree*, but the push carries a revision range.
# Those differ whenever the pushed commits were not checked out -- a plumbing
# push, or a push from a tree sitting on another branch -- and then the hook
# refuses a push on the strength of state that push does not contain. Read the
# range git supplies on stdin and skip when nothing in it touches dependency
# resolution: a push that changes no manifest and no lock cannot make the lock
# worse than the base already found acceptable.
touches_dependency_state=unknown
pushed_tip=""
# The range this push carries, for the local gate far below. Recorded here
# because stdin reads once: the gate cannot re-read it.
gate_tip=""
gate_range_base=""
if [ ! -t 0 ]; then
  touches_dependency_state=no
  zero="$(printf '0%.0s' $(seq 40))"
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    # A branch deletion carries no content.
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
      # New branch: compare against the merge-base with the default branch,
      # so a long series is not read as touching everything. Comparing
      # against HEAD instead is vacuous exactly when it matters: pushing
      # the checked-out branch makes the base the pushed tip itself, the
      # range is empty, and a manifest-changing push skips the check.
      base="$(default_branch_base "$local_sha" || true)"
      [ -z "$base" ] && { touches_dependency_state=unknown; break; }
    elif git merge-base --is-ancestor "$remote_sha" "$local_sha" 2>/dev/null; then
      # Ordinary branch updates extend the remote tip, so only new commits
      # enter the gate range.
      base="$remote_sha"
    else
      # Publication branches may be rebuilt from a newer default branch.
      # Their previous tip is then outside the new history; gate the PR delta
      # from the new tip's default-branch base rather than unrelated mainline
      # changes between the two generated commits.
      base="$(default_branch_base "$local_sha" || true)"
      [ -z "$base" ] && { touches_dependency_state=unknown; break; }
    fi
    if [ -z "$gate_tip" ]; then
      gate_tip="$local_sha"
      gate_range_base="$base"
    fi
    if ! changed="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"; then
      touches_dependency_state=unknown
      break
    fi
    if printf '%s\n' "$changed" | grep -qE '(^|/)Cargo\.(lock|toml)$'; then
      touches_dependency_state=yes
      pushed_tip="$local_sha"
      break
    fi
  done
fi

# No manifest in the range means the lock cannot have changed: skip its check,
# but still run the code gate -- a source-only push still needs lint and tests.
if [ "$touches_dependency_state" = "no" ]; then
  echo "pre-push: no Cargo.lock or Cargo.toml in the pushed range; lockfile check not needed" >&2
  skip_lockfile=1
fi

# `--check` measures the working tree, so its verdict is evidence about the
# pushed commits only while the two agree on dependency state. They diverge
# exactly when it matters: any cargo command rewrites `Cargo.lock`, so a tree
# whose lock a test run already repaired passes this check while the commits
# being pushed still carry the stale one. That is how a stale lock reached
# main once and failed every `--locked` job after it.
#
# The interpreter is resolved here, before any section that may be skipped:
# the lockfile section below is skipped on every push that leaves manifests
# alone, and under `set -u` a later reader of `python_bin` -- the SAFETY
# ratchet below -- would then abort the hook instead of running.
python_bin="${PYTHON:-}"
if [ -z "$python_bin" ]; then
  for candidate in python3 python; do
    # Probe the candidate, not just its presence on PATH: the WindowsApps
    # python3.exe Store stub passes `command -v` and then fails to execute
    # (rc 127), and selecting it makes every `"$python_bin" -c ...` below
    # fail -- the workspace-membership pipeline in particular, which under
    # `set -o pipefail` blocks the push with a diagnostic about cargo that
    # the interpreter caused. Same probe as `.githooks/pre-commit`.
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c 'import sys' >/dev/null 2>&1; then
      python_bin="$candidate"
      break
    fi
  done
fi

# The skips above fall through to the code gate, so this whole section runs
# only when the lock still wants verifying.
if [ "$skip_lockfile" = "0" ]; then
# The lock is checked on an export of the pushed revision, with that
# revision's own checker, outside the stack: the working tree is neither the
# push (a peer's branch, a plumbing push) nor stable (any cargo command inside
# the stack flattens its lock), so a verdict on it was evidence about the
# wrong state either way. The dependency-source check below reads the same
# export.
lock_rev="${pushed_tip:-${gate_tip:-HEAD}}"
lock_export="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-lock.XXXXXX")"
if ! git archive "$lock_rev" | tar -x -C "$lock_export"; then
  rm -rf "$lock_export"
  echo "pre-push: could not export $lock_rev for the lockfile check" >&2
  exit 1
fi
checker="$lock_export/scripts/lockfile.py"

if [ ! -f "$checker" ]; then
  # A guard that reports its own absence and lets the push through is the
  # absence. The code gate below would still have run, but the lock is what
  # this section is for, and an unverified lock is the failure it exists to
  # stop -- so refuse here; there is no deliberate way through.
  rm -rf "$lock_export"
  echo "pre-push: scripts/lockfile.py not present; lockfile not verified" >&2
  exit 1
elif [ -z "$python_bin" ]; then
  rm -rf "$lock_export"
  echo "pre-push: no python interpreter found; lockfile not verified" >&2
  exit 1
elif ! (cd "$lock_export" && "$python_bin" "$checker" --check); then
  rm -rf "$lock_export"
  cat >&2 <<MESSAGE

pre-push: the Cargo.lock in $lock_rev does not resolve under --locked, so
every CI job that passes --locked would fail on this push.

The usual cause is a cargo command run from inside the Atlas stack, which
strips the lock's git sources. Repair it with:

    python3 scripts/lockfile.py --regenerate

then stage the result and push again.
MESSAGE
  exit 1
fi

# Dependency sources. A lock advance can bring in git sources `deny.toml`
# does not allow, and nothing above reads them: harmonia#19 merged on a green
# `--locked` build and left CI red until harmonia#21 allowed three new
# first-party sources. cargo-deny cannot run in this checkout -- it resolves
# from the workspace root, so inside the stack the development overlay
# answers, every git source reads as unencountered, `sources ok` is vacuous,
# and the lock is rewritten -- so it runs on an export of the pushed revision
# outside the stack, which is exactly what CI resolves. The working tree is
# never touched.
if [ -f "$repo_root/deny.toml" ]; then
  if ! cargo deny --version >/dev/null 2>&1; then
    rm -rf "$lock_export"
    echo "pre-push: cargo-deny is not installed, so the dependency sources of this" >&2
    echo "lock change are unverified. Install it: cargo install --locked cargo-deny" >&2
    exit 1
  fi
  if ! (cd "$lock_export" && cargo deny --locked check sources >&2); then
    rm -rf "$lock_export"
    cat >&2 <<MESSAGE

pre-push: the pushed Cargo.lock resolves a source deny.toml does not allow,
so the CI supply-chain job would fail on this push. Allow the source in
deny.toml (a first-party git source goes under [sources] allow-git) or drop
the dependency.
MESSAGE
    exit 1
  fi
fi
rm -rf "$lock_export"
fi
# End of the lockfile section; the code gate below runs unconditionally.

# ---------------------------------------------------------------------------
# Artifact budgets: PM boards under their line budget, tracked images under
# their byte budget (scripts/atlas-artifact-budget.py, ratchet-to-budget: an
# over-budget board may not grow, an oversized image may not be added or
# touched). Boards reached 6,325/7,609/7,570 lines and screenshots 1.5 MB in
# one member before anything measured either. The script lives in the stack
# root; a standalone clone outside the stack reports and continues, since the
# shared CI workflow (artifact-budget.yml) is the authoritative gate there.
# The gate judges the pushed tip against the pushed range's base, never the
# working tree a peer may hold dirty and never `HEAD`: a plumbing push, or a
# shared tree checked out on a peer's branch, makes `HEAD` a revision this push
# does not carry, and a peer's over-budget board then refused an unrelated
# push. `HEAD` against its upstream remains the fallback when git supplied no
# range (a manual run with no stdin).
range_rev="${gate_tip:-HEAD}"
range_base=""
if [ -n "$gate_range_base" ] \
  && git rev-parse --verify --quiet "$gate_range_base^{commit}" >/dev/null 2>&1; then
  range_base="$gate_range_base"
elif [ -z "$gate_tip" ] \
  && upstream="$(git rev-parse --verify --quiet '@{upstream}' 2>/dev/null)"; then
  range_base="$upstream"
else
  range_base="$(default_branch_base "$range_rev" || true)"
fi
range_args=()
[ -n "$range_base" ] && range_args=(--base "$range_base")

budget_checker="$repo_root/../../scripts/atlas-artifact-budget.py"
if [ -f "$budget_checker" ] && [ -n "$python_bin" ]; then
  if ! "$python_bin" "$budget_checker" check --root "$repo_root" --rev "$range_rev" "${range_args[@]}"; then
    echo "pre-push: BLOCKED -- a PM board grew past its line budget or a tracked" >&2
    echo "image exceeds the byte budget. Compact the board (done items delete)," >&2
    echo "move evidence captures out of git, and push again." >&2
    exit 1
  fi
else
  echo "pre-push: artifact-budget checker not reachable from this clone; CI enforces it" >&2
fi

# Credentials: the lines the pushed range adds, scanned before they leave the
# machine (scripts/atlas-secret-scan.py). A secret that reaches a remote is
# published -- a rewritten history does not unpublish it -- so this is the one
# check CI cannot stand in for: by the time a runner sees the push, the value
# is already out. Same range as the budget check above.
secret_checker="$repo_root/../../scripts/atlas-secret-scan.py"
if [ -f "$secret_checker" ] && [ -n "$python_bin" ]; then
  if ! "$python_bin" "$secret_checker" check --root "$repo_root" --rev "$range_rev" "${range_args[@]}"; then
    echo "pre-push: BLOCKED -- the pushed range adds a credential. Remove it from" >&2
    echo "every commit in the range; if it ever reached a remote, rotate it." >&2
    exit 1
  fi
else
  echo "pre-push: secret scanner not reachable from this clone; the pushed range was not scanned" >&2
fi

# Debt ratchet: the pushed revision's conformance classes may not rise above
# the counts atlas records for this member. CI runs the same script through
# conformance-guard.yml (`atlas-conformance.py check --repo <member>
# --member-path .`); nothing local did, so metis#394 passed every stage here
# and then failed CI on `oversized_files: 0 -> 1` and
# `existence_only_assertions: 0 -> 1`.
#
# Every input is a committed revision. The content is the pushed tip
# (`--member-revision`), never the working tree a peer may hold on another
# branch or dirty. The checker and its baseline both come from the stack's
# fetched default branch: the stack checkout sits on whatever branch a peer
# left there, often one cut before this check existed, and its scripts would
# then decide the verdict. That revision's `scripts/` is extracted once into
# the stack's git directory and run with `ATLAS_STACK_ROOT` naming the live
# stack, since cited hashes resolve against every member's object store and
# only the stack holds them all. Citations are bounded by what the range's
# base measures today (`--drift-base`), so a branch deleted elsewhere does
# not refuse a push that cites nothing new.
#
# Git exports GIT_DIR to hooks -- an absolute path in a lane -- and a git or
# checker process aimed at another repository inherits it and answers about
# this checkout instead: from a hephaestus lane, the stack's `origin/HEAD`
# resolved to hephaestus's own and the ratchet was skipped as unreachable.
# Every such process runs through `outside_checkout`.
outside_checkout() {
  env -u GIT_DIR -u GIT_WORK_TREE -u GIT_INDEX_FILE -u GIT_PREFIX \
    -u GIT_COMMON_DIR "$@"
}
stack_root="$(cd "$repo_root/../.." && pwd)"
stack_top="$(outside_checkout git -C "$stack_root" rev-parse --show-toplevel 2>/dev/null || true)"
stack_baseline=""
if [ -n "$stack_top" ] && [ "$(cd "$stack_top" && pwd)" = "$stack_root" ]; then
  for ref in origin/HEAD origin/main; do
    stack_baseline="$(outside_checkout git -C "$stack_root" rev-parse --verify --quiet "$ref^{commit}" 2>/dev/null || true)"
    [ -n "$stack_baseline" ] && break
  done
fi
if [ ! -t 0 ] && [ -z "$gate_tip" ]; then
  # Every ref git named was a deletion: there is no revision to judge, and
  # `HEAD` is not something this push carries.
  echo "pre-push: the push carries no commits; debt ratchet not needed" >&2
elif [ -n "$stack_baseline" ] && [ -n "$python_bin" ] \
  && outside_checkout git -C "$stack_root" cat-file -e "$stack_baseline:scripts/atlas-conformance.py" 2>/dev/null; then
  # The member is the registered directory sharing this checkout's object
  # store, so a lane (`worktrees/<repo>-<branch>`) resolves to its repository.
  own_store="$(cd "$repo_root" && cd "$(outside_checkout git rev-parse --git-common-dir)" && pwd)"
  conformance_member=""
  for candidate in "$stack_root/repos/${repo_root##*/}" "$stack_root"/repos/*; do
    [ -d "$candidate" ] || continue
    candidate_store="$(cd "$candidate" 2>/dev/null \
      && cd "$(outside_checkout git rev-parse --git-common-dir 2>/dev/null)" 2>/dev/null \
      && pwd)" || continue
    if [ "$candidate_store" = "$own_store" ]; then
      conformance_member="${candidate##*/}"
      break
    fi
  done
  checker_cache="$(cd "$stack_root" && cd "$(outside_checkout git rev-parse --git-common-dir)" && pwd)/atlas-checker"
  checker_dir="$checker_cache/$stack_baseline"
  if [ -z "$conformance_member" ]; then
    echo "pre-push: not a registered stack member; debt ratchet not run" >&2
  else
    if [ ! -f "$checker_dir/scripts/atlas-conformance.py" ]; then
      mkdir -p "$checker_cache"
      staging="$(mktemp -d "$checker_cache/.staging.XXXXXX")"
      outside_checkout git -C "$stack_root" archive "$stack_baseline" scripts | tar -x -C "$staging"
      # A concurrent push may have placed the same revision first; either
      # copy is the same content, so the rename losing is not an error.
      mv "$staging" "$checker_dir" 2>/dev/null || rm -rf "$staging"
      # Other revisions' copies go once no scan can still be using them.
      if ! find "$checker_cache" -mindepth 1 -maxdepth 1 -type d \
        ! -name "$stack_baseline" -mmin +60 -exec rm -rf {} +; then
        echo "pre-push: could not prune old checker copies under $checker_cache" >&2
      fi
    fi
    conformance_checker="$checker_dir/scripts/atlas-conformance.py"
    if [ ! -f "$conformance_checker" ]; then
      echo "pre-push: BLOCKED -- could not extract the stack's checker at ${stack_baseline:0:12}." >&2
      exit 1
    elif ! grep -q ATLAS_STACK_ROOT "$checker_dir/scripts/atlas_stack.py"; then
      # The stack's fetched default predates revision scans: fetch it.
      echo "pre-push: the stack's checker at ${stack_baseline:0:12} predates revision scans;" >&2
      echo "debt ratchet not run. Run: git -C $stack_root fetch origin" >&2
    else
      drift_args=()
      [ -n "$range_base" ] && drift_args=(--drift-base "$range_base")
      set +e
      outside_checkout ATLAS_STACK_ROOT="$stack_root" "$python_bin" "$conformance_checker" check \
        --repo "$conformance_member" --member-path "$repo_root" \
        --member-revision "$range_rev" --baseline-rev "$stack_baseline" \
        "${drift_args[@]}" >&2
      conformance_status=$?
      set -e
      if [ "$conformance_status" -eq 1 ]; then
        echo "pre-push: BLOCKED -- the pushed revision raises a debt class above the" >&2
        echo "baseline atlas ${stack_baseline:0:12} records for $conformance_member." >&2
        echo "Fix the debt; never regenerate the baseline over it. Reproduce:" >&2
        echo "  ATLAS_STACK_ROOT=$stack_root python $conformance_checker check --repo $conformance_member --member-path $repo_root --member-revision $range_rev --baseline-rev $stack_baseline ${drift_args[*]}" >&2
        exit 1
      elif [ "$conformance_status" -ne 0 ]; then
        echo "pre-push: BLOCKED -- the debt ratchet could not run (exit $conformance_status)." >&2
        exit 1
      fi
    fi
  fi
else
  echo "pre-push: no stack checker reachable from this clone; debt ratchet not run, CI enforces it" >&2
fi

# ---------------------------------------------------------------------------
# Fast local gate, scoped to the pushed range.
#
# The lockfile guard above is one third of what CI runs, and the other two
# thirds are where defects have actually escaped: a merge once landed two
# clippy denials that turned the architecture validation red on main and on
# every pull request that merged it, because nothing local ran clippy.
# CI should confirm, not discover.
#
# Scope is the push, not the workspace: a workspace clippy takes minutes on a
# large member, and a gate that slow is a gate people bypass. The changed files
# map to their packages and only those are linted and tested.
#
# `cargo fmt` needs no dependency resolution; clippy and nextest do, and how
# they resolve decides whether this gate is usable at all. Cargo finds the
# stack's `[patch]` overlay by walking up from the working directory, so running
# from a neutral directory with `--manifest-path` escapes it -- and with it the
# shared target directory and every first-party dependency, which then resolve
# to their git sources instead of the local trees. Nothing in the cache matches
# and the gate rebuilds the world: measured at over ten minutes for a single
# leaf crate, which is not a pre-push gate.
#
# So these run from the repository, inside the overlay, on the warm cache. The
# cost is that cargo rewrites `Cargo.lock` as it goes -- stripping the git
# sources CI needs -- which is the very corruption the guard above exists to
# catch. The lock is therefore restored byte-for-byte afterwards, whatever it
# held, so the gate cannot damage what it just verified.
#
# For the same reason nothing here passes `--locked`: under the overlay the lock
# *must* change, so `--locked` would fail on resolution before reaching a line
# of code. Lock correctness is the guard's job, checked from outside the
# overlay; this gate's job is the code.
#
# Bypass deliberately:
#
#     SKIP_LOCAL_GATE=1 git push

if [ "${SKIP_LOCAL_GATE:-0}" = "1" ]; then
  echo "pre-push: local gate skipped by SKIP_LOCAL_GATE" >&2
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  # No toolchain on this machine (docs-only checkout, bare CI image without
  # Rust): say so rather than failing every push on a missing binary.
  echo "pre-push: no cargo toolchain found; local gate not run" >&2
  exit 0
fi

# Select from the pushed range where git supplied one: `HEAD` is the
# checkout's branch, which a plumbing push or a tree sitting on a peer's branch
# makes the wrong revision to select from. A base the local repository cannot
# resolve -- a remote tip never fetched here -- falls back rather than diffing
# against nothing, which would read as "no Rust in the range" and skip the gate.
if [ -n "$gate_range_base" ] \
  && ! git rev-parse --verify --quiet "$gate_range_base^{commit}" >/dev/null 2>&1; then
  gate_range_base=""
fi
gate_tip_rev="${gate_tip:-HEAD}"
if [ -n "$gate_range_base" ]; then
  gate_base="$gate_range_base"
else
  gate_base="$(default_branch_base "$gate_tip_rev" || true)"
fi

if [ -z "$gate_base" ]; then
  echo "pre-push: no upstream or remote default branch to diff against; local gate skipped" >&2
  exit 0
fi

gate_changed="$(git diff --name-only "$gate_base" "$gate_tip_rev" 2>/dev/null || true)"

# Where cargo runs. A member's main tree runs inside the stack, so the gate
# builds against the local working trees the overlay provides. A lane (a
# linked worktree) cannot: the overlay patches this member's packages to its
# main tree while the lane's workspace defines the same packages, and cargo
# stops with "package collision in the lockfile" -- a moirai lane push was
# refused that way as a clippy failure. A lane therefore runs from a directory
# outside the stack, naming its manifest and the stack's shared target
# directory, which resolves the committed lock exactly as CI does.
gate_cwd="$repo_root"
gate_manifest=""
# `cargo fmt` finds no targets in a virtual manifest named by path, so a lane
# names every member; in place it reads the workspace from the working
# directory, and `--all` there would also reach the overlay's patched trees.
gate_fmt_scope=""
if [ "$(git rev-parse --git-dir)" != "$(git rev-parse --git-common-dir)" ]; then
  overlay_config=""
  search_dir="$(dirname "$repo_root")"
  while [ "$search_dir" != "/" ] && [ "$search_dir" != "." ]; do
    if [ -f "$search_dir/.cargo/config.toml" ]; then
      overlay_config="$search_dir/.cargo/config.toml"
      break
    fi
    parent="$(dirname "$search_dir")"
    [ "$parent" = "$search_dir" ] && break
    search_dir="$parent"
  done
  if [ -n "$overlay_config" ]; then
    if [ -z "${CARGO_TARGET_DIR:-}" ]; then
      stack_target="$(sed -n 's/^[[:space:]]*target-dir[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$overlay_config" | head -1)"
      case "$stack_target" in
        "") ;;
        /*|[A-Za-z]:*) export CARGO_TARGET_DIR="$stack_target" ;;
        *) export CARGO_TARGET_DIR="$(dirname "$(dirname "$overlay_config")")/$stack_target" ;;
      esac
    fi
    gate_cwd="$(mktemp -d "${TMPDIR:-/tmp}/pre-push-lane.XXXXXX")"
    # Leading space: the reproduce lines render as `cargo doc --no-deps$gate_specs`,
    # and without it the flag joins the subcommand ("--no-deps--manifest-path").
    gate_manifest=" --manifest-path $repo_root/Cargo.toml"
    gate_fmt_scope="--all"
    echo "pre-push: lane of an overlaid member; gating outside the stack overlay" >&2
  fi
fi

cleanup_gate_cwd() {
  if [ "$gate_cwd" != "$repo_root" ]; then
    rm -rf "$gate_cwd" 2>/dev/null || true
  fi
}

if [ -z "$python_bin" ]; then
  echo "pre-push: no python interpreter found; Cargo workspace membership not verified" >&2
  echo "pre-push: push anyway with SKIP_LOCAL_GATE=1 git push" >&2
  cleanup_gate_cwd
  exit 1
fi

# Cargo is the authority on which package manifests belong to this workspace.
# A nested standalone manifest (cargo-fuzz is the common case) can legally use
# the same package name as a member, so names alone cannot establish ownership.
# `--no-deps` reads membership without resolving dependencies or changing the
# lockfile. Each output record is `<repo-relative manifest><tab><package name>`.
if ! workspace_members="$(
  cd "$gate_cwd" && cargo metadata --no-deps --format-version 1 $gate_manifest |
    "$python_bin" -c 'import json, os, sys
metadata = json.load(sys.stdin)
members = set(metadata["workspace_members"])
root = os.path.realpath(sys.argv[1])
for package in metadata["packages"]:
    if package["id"] not in members:
        continue
    manifest = os.path.realpath(package["manifest_path"])
    relative = os.path.relpath(manifest, root).replace(os.sep, "/")
    print(f"{relative}\t{package['"'"'name'"'"']}")' "$repo_root"
)"; then
  echo "pre-push: cargo metadata could not establish workspace membership" >&2
  echo "pre-push: push anyway with SKIP_LOCAL_GATE=1 git push" >&2
  cleanup_gate_cwd
  exit 1
fi

# Changed paths -> the packages that own them. Ownership uses the nearest
# ancestor `[package]` manifest, then membership is checked against Cargo's
# workspace graph above. This includes committed fixtures: they are behavioral
# inputs to the owning package's tests even when no Rust source changed.
gate_packages=""
excluded_manifests=""
while IFS= read -r changed_path; do
  [ -n "$changed_path" ] || continue
  owner_dir="$(dirname "$changed_path")"
  package_dir=""
  excluded_manifest=""
  while [ "$owner_dir" != "." ] && [ "$owner_dir" != "/" ]; do
    manifest="$repo_root/$owner_dir/Cargo.toml"
    if [ -f "$manifest" ]; then
      if grep -qE '^\[package\]' "$manifest" 2>/dev/null; then
        package_dir="$owner_dir"
      elif grep -qE '^\[workspace\]' "$manifest" 2>/dev/null; then
        excluded_manifest="$owner_dir/Cargo.toml"
      fi
      break
    fi
    owner_dir="$(dirname "$owner_dir")"
  done
  if [ -n "$excluded_manifest" ]; then
    case " $excluded_manifests " in
      *" $excluded_manifest "*) ;;
      *) excluded_manifests="$excluded_manifests $excluded_manifest" ;;
    esac
    continue
  fi
  if [ -z "$package_dir" ]; then
    if [ -f "$repo_root/Cargo.toml" ] && grep -qE '^\[package\]' "$repo_root/Cargo.toml" 2>/dev/null; then
      package_dir="."
    else
      continue
    fi
  fi
  manifest="$repo_root/$package_dir/Cargo.toml"
  relative_manifest="${manifest#"$repo_root"/}"
  relative_manifest="${relative_manifest#./}"
  package_name="$(printf '%s\n' "$workspace_members" | awk -F '\t' -v manifest="$relative_manifest" '$1 == manifest { print $2; exit }')"
  if [ -z "$package_name" ]; then
    case " $excluded_manifests " in
      *" $relative_manifest "*) ;;
      *) excluded_manifests="$excluded_manifests $relative_manifest" ;;
    esac
    continue
  fi
  case " $gate_packages " in
    *" $package_name "*) ;;
    *) gate_packages="$gate_packages $package_name" ;;
  esac
done <<GATE_PATHS
$gate_changed
GATE_PATHS

if [ -n "${excluded_manifests// /}" ]; then
  cat >&2 <<MESSAGE

pre-push: changed files belong to a Cargo workspace excluded from the parent
workspace:$excluded_manifests

The parent gate cannot verify it with a parent-workspace -p argument. Run that
workspace's configured gate and commit its evidence, or push anyway with
SKIP_LOCAL_GATE=1 git push.
MESSAGE
  cleanup_gate_cwd
  exit 1
fi

if [ -z "${gate_packages// /}" ]; then
  echo "pre-push: no package owns the changed files; local gate not needed" >&2
  cleanup_gate_cwd
  exit 0
fi

# Run one gate step and say whose failure it was.
#
# The step runs inside the stack overlay, so its dependency graph is the local
# working trees rather than the git sources CI resolves. When that graph is
# broken -- a member whose version requirement lags its provider's, so the
# overlay cannot patch it and one crate resolves to git while its dependencies
# resolve local -- the step fails on a crate under `~/.cargo`, nowhere near the
# push. Reporting that as "your clippy fails" is how a gate loses its
# credibility and starts getting bypassed.
#
# The verdict defaults to 'ours' and only an affirmative case moves it. A
# failing test emits no compile diagnostics at all, so "found nothing outside
# the repository" must not be read as "the environment did it" -- that reading
# passed a deliberately failing test during probing, which is the exact defect
# this gate exists to prevent. Blame the change unless the evidence positively
# says otherwise.
#
# Echoes 'ours', 'environment', or 'ok'.
normalise_diagnostic_path() {
  local value="$1"
  value="$(printf '%s' "$value" | tr 'A-Z\' 'a-z/' 2>/dev/null)"

  # Git Bash can expose the repository through its long path while cargo's
  # diagnostics use an equivalent DOS 8.3 path (for example, RYANCL~1). Use
  # one Windows spelling for both sides when cygpath is available; POSIX
  # runners retain the normalized slash form above.
  if command -v cygpath >/dev/null 2>&1; then
    case "$value" in
      [a-z]:/*|/*)
        local short_value
        if short_value="$(cygpath -m -s "$value" 2>/dev/null)"; then
          # cygpath spells the drive letter upper case; the classifier's
          # drive-path case is lower case, as the first pass left it.
          value="$(printf '%s' "$short_value" | tr 'A-Z' 'a-z')"
        fi
        ;;
    esac
  fi
  printf '%s' "$value"
}

classify_gate_step() {
  local log="$1"
  shift
  if (cd "$gate_cwd" && "$@" >"$log" 2>&1); then
    echo ok
    return 0
  fi

  # Two workspaces defining one package is the overlay meeting a lane, never
  # the change: see the lane selection above `gate_specs`.
  if grep -q 'package collision in the lockfile' "$log"; then
    echo environment
    return 0
  fi

  local root_normalised inside=0 outside=0 location foreign_crate=0
  root_normalised="$(normalise_diagnostic_path "$repo_root")"

  # Only locations under an `error` header count. A crate that fails to compile
  # still emits warnings for whatever did compile, and counting those made the
  # verdict depend on what the build cache happened to hold.
  #
  # Deduplication is awk, not `sort -u`: on Windows developer machines `sort`
  # can resolve to the System32 SORT.EXE, which rejects `-u` and empties the
  # pipeline -- every verdict then degrades to 'ours'.
  while IFS= read -r location; do
    [ -n "$location" ] || continue
    location="$(normalise_diagnostic_path "$location")"
    case "$location" in
      /*|[a-z]:/*)
        case "$location" in
          "$root_normalised"/*) inside=$((inside + 1)) ;;
          *) outside=$((outside + 1)) ;;
        esac
        ;;
      *) inside=$((inside + 1)) ;;
    esac
  done <<DIAGNOSTICS
$(awk '/^error/ { under_error = 1; next } /^warning/ { under_error = 0; next } under_error && /^[[:space:]]*--> / { sub(/^[[:space:]]*--> /, ""); sub(/:[0-9]+:[0-9]+$/, ""); if (!seen[$0]++) print }' "$log")
DIAGNOSTICS

  # A cached rebuild can report `could not compile` without re-emitting the
  # diagnostic that explains it, so the failing crate's name is a second
  # witness: one that is not being gated is not this push's.
  local failed_crate
  while IFS= read -r failed_crate; do
    [ -n "$failed_crate" ] || continue
    case " $gate_packages " in
      *" $failed_crate "*) ;;
      *) foreign_crate=$((foreign_crate + 1)) ;;
    esac
  done <<CRATES
$(sed -n 's/^error: could not compile `\([^`]*\)`.*/\1/p' "$log" | awk '!seen[$0]++')
CRATES

  if [ "$inside" -eq 0 ] && { [ "$outside" -gt 0 ] || [ "$foreign_crate" -gt 0 ]; }; then
    echo environment
  else
    echo ours
  fi
}

report_broken_graph() {
  local step="$1" log="$2"
  cat >&2 <<MESSAGE

pre-push: the $step step failed, but every diagnostic points outside this
repository, so the local dependency graph is broken rather than this change.
That is usually the stack overlay: a member whose requirement lags its
provider stays git-sourced while its dependencies resolve locally, and the
halves disagree.

The gate could not run, so this push is NOT verified. First diagnostic:

MESSAGE
  grep -m 1 -A 3 -E '^error' "$log" >&2 || true
  cat >&2 <<'MESSAGE'

Check with `python scripts/atlas-stack-overlay.py check` at the stack root.
MESSAGE
}

gate_specs="$gate_manifest"
for package_name in $gate_packages; do
  gate_specs="$gate_specs -p $package_name"
done

echo "pre-push: gating${gate_packages}" >&2

# Restore whatever the lock held before this gate ran -- the committed content,
# or a developer's own uncommitted edit to it. Copying the bytes rather than
# checking out the committed file is what makes the second case safe: this hook
# must not decide that someone's in-progress lock work was a side effect of its
# own.
gate_lock="$repo_root/Cargo.lock"
gate_lock_backup=""
if [ -f "$gate_lock" ]; then
  gate_lock_backup="$(mktemp)"
  cp -p "$gate_lock" "$gate_lock_backup"
fi

restore_gate_lock() {
  if [ -n "$gate_lock_backup" ] && [ -f "$gate_lock_backup" ]; then
    if ! cmp -s "$gate_lock_backup" "$gate_lock" 2>/dev/null; then
      cp -p "$gate_lock_backup" "$gate_lock" || true
    fi
    rm -f "$gate_lock_backup" || true
  fi
  rm -f "${gate_log:-}" 2>/dev/null || true
  cleanup_gate_cwd
}

trap restore_gate_lock EXIT INT TERM

# Formatting is workspace-wide and near-instant, and its failure is the
# cheapest one to find here rather than on a runner.
if ! (cd "$gate_cwd" && cargo fmt $gate_fmt_scope $gate_manifest -- --check >/dev/null); then
  cat >&2 <<'MESSAGE'

pre-push: `cargo fmt --check` fails, so the architecture validation would.

Run `cargo fmt` and stage the result. To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
  exit 1
fi

# The SAFETY ratchet is a member-owned, whole-repository text scan that CI's
# workspace job runs after the checks above. apollo#397 passed this gate and
# then failed CI on a `// SAFETY:` comment two lines above its block, because
# nothing here ran the ratchet. It is text-only and fast, so it runs before the
# compile steps; a member without the script has no ratchet to run.
safety_ratchet="$repo_root/scripts/safety_ratchet.py"
if [ -f "$safety_ratchet" ]; then
  if [ -z "$python_bin" ]; then
    echo "pre-push: scripts/safety_ratchet.py present but no python interpreter found" >&2
    echo "pre-push: push anyway with SKIP_LOCAL_GATE=1 git push" >&2
    exit 1
  fi
  if ! (cd "$repo_root" && "$python_bin" scripts/safety_ratchet.py check >&2); then
    cat >&2 <<'MESSAGE'

pre-push: the SAFETY ratchet fails, so CI's workspace job would. Put a
`// SAFETY:` comment directly above each new `unsafe {` block, stating the
obligation it discharges.

Reproduce:

    python scripts/safety_ratchet.py check

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
    exit 1
  fi
fi

# The workspace lint table denies what matters, so this gate runs clippy
# without extra flags: adding `-D warnings` here would fail on the
# pre-existing per-crate debt the ratchet exists to burn down, and a gate
# that fails on debt you did not write is a gate that gets bypassed.
gate_log="$(mktemp)"
trap 'rm -f "$gate_log"; restore_gate_lock' EXIT INT TERM

case "$(classify_gate_step "$gate_log" cargo clippy $gate_specs --all-targets)" in
  ours)
    cat >&2 <<MESSAGE

pre-push: clippy fails for$gate_packages, so the CI ratchet would.

Reproduce:

    cargo clippy$gate_specs --all-targets

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
    exit 1
    ;;
  environment)
    report_broken_graph clippy "$gate_log"
    exit 0
    ;;
esac

if command -v cargo-nextest >/dev/null 2>&1; then
  case "$(classify_gate_step "$gate_log" cargo nextest run $gate_specs)" in
    ours)
      cat >&2 <<MESSAGE

pre-push: tests fail for$gate_packages.

Reproduce:

    cargo nextest run$gate_specs

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
      exit 1
      ;;
    environment)
      report_broken_graph test "$gate_log"
      exit 0
      ;;
  esac
else
  echo "pre-push: cargo-nextest not installed; tests not run" >&2
fi

# CI documents every package with `RUSTDOCFLAGS=-D warnings`, so a broken or
# redundant intra-doc link that clippy and the tests never see turns main red
# after the merge (a redundant link target from apollo#508 did). The changed
# packages are documented here the same way.
case "$(classify_gate_step "$gate_log" env RUSTDOCFLAGS="-D warnings" cargo doc --no-deps $gate_specs)" in
  ours)
    cat >&2 <<MESSAGE

pre-push: rustdoc fails for$gate_packages, so the CI rustdoc shard would.

Reproduce:

    RUSTDOCFLAGS="-D warnings" cargo doc --no-deps$gate_specs

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
    exit 1
    ;;
  environment)
    report_broken_graph rustdoc "$gate_log"
    exit 0
    ;;
esac

echo "pre-push: local gate passed" >&2
