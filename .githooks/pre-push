#!/usr/bin/env bash
#
# Atlas member-side pre-push gate (single owned copy; see below).
#
# Two guards, in order: the lockfile must resolve under `--locked`, and the
# packages the push changes must pass fmt, clippy, and their tests. CI confirms
# what this found; it should not be where a defect is discovered.
#
# Refuse a push whose Cargo.lock cannot resolve under `--locked`.
#
# A member is normally worked on inside the Atlas stack, whose
# `.cargo/config.toml` carries a `[patch]` overlay redirecting every first-party
# dependency to a local working tree. Cargo finds that config by walking up from
# the current directory, so *any* cargo command run from inside the stack -- a
# test run, a check, a build -- rewrites `Cargo.lock` with every
# `source = "git+..."` line stripped. That lock resolves perfectly under the
# same overlay, which is why local verification never sees the problem, and
# fails every `--locked` job in CI, which has no overlay.
#
# `scripts/lockfile.py --check` runs cargo from outside the overlay and is the
# same check CI runs, so a push that would fail there never reaches a runner.
#
# Single source: this file is owned here and deployed outward to every
# member's `.githooks/` by `scripts/atlas-lock-form.py sync-hooks`
# (`--check` reports drift, which is what CI runs). Do not hand-edit member
# copies; change this file and re-sync. A member copy that differs from this
# file is drift, counted by the conformance `member_gate_versions` class.
#
# Install (git does not apply tracked hooks on its own):
#
#     python scripts/atlas-lock-form.py install-hooks
#
# Bypass deliberately:
#
#     SKIP_LOCKFILE_CHECK=1 git push   (lockfile section only)
#     SKIP_LOCAL_GATE=1 git push       (fast gate section only)
set -euo pipefail

# SKIP_LOCKFILE_CHECK skips the lockfile section only; the code gate below
# still runs. (Exiting here once skipped the gate too, so the bypass silently
# skipped lint and tests as well.)
skip_lockfile=0
if [ "${SKIP_LOCKFILE_CHECK:-0}" = "1" ]; then
  echo "pre-push: lockfile check skipped by SKIP_LOCKFILE_CHECK" >&2
  skip_lockfile=1
fi

# A managed worktree may be owned by a different filesystem account than the
# process pushing from it, and git does not propagate command-line config into
# hooks. Re-inject the checkout path so child git calls stay valid.
repo_root="$(git -c safe.directory="$PWD" rev-parse --show-toplevel)"
export GIT_CONFIG_COUNT=1
export GIT_CONFIG_KEY_0=safe.directory
export GIT_CONFIG_VALUE_0="$repo_root"

# The remote's default branch is whatever the remote says it is: `origin/HEAD`
# follows a rename, `origin/main` does not (hephaestus defaults to `master`).
# Echoes the merge-base of `$1` with that branch, or nothing when neither
# ref resolves.
default_branch_base() {
  local tip="$1" ref ref_sha base
  for ref in origin/HEAD origin/main; do
    ref_sha="$(git rev-parse --verify --quiet "$ref" 2>/dev/null || true)"
    [ -n "$ref_sha" ] || continue
    base="$(git merge-base "$ref_sha" "$tip" 2>/dev/null || true)"
    if [ -n "$base" ]; then
      printf '%s' "$base"
      return 0
    fi
  done
  return 1
}

# The check measures the *working tree*, but the push carries a revision range.
# Those differ whenever the pushed commits were not checked out -- a plumbing
# push, or a push from a tree sitting on another branch -- and then the hook
# refuses a push on the strength of state that push does not contain. Read the
# range git supplies on stdin and skip when nothing in it touches dependency
# resolution: a push that changes no manifest and no lock cannot make the lock
# worse than the base already found acceptable.
touches_dependency_state=unknown
pushed_tip=""
if [ ! -t 0 ]; then
  touches_dependency_state=no
  zero="$(printf '0%.0s' $(seq 40))"
  while read -r _local_ref local_sha _remote_ref remote_sha; do
    # A branch deletion carries no content.
    [ "$local_sha" = "$zero" ] && continue
    if [ "$remote_sha" = "$zero" ]; then
      # New branch: compare against the merge-base with the default branch,
      # so a long series is not read as touching everything. Comparing
      # against HEAD instead is vacuous exactly when it matters: pushing
      # the checked-out branch makes the base the pushed tip itself, the
      # range is empty, and a manifest-changing push skips the check.
      base="$(default_branch_base "$local_sha" || true)"
      [ -z "$base" ] && { touches_dependency_state=unknown; break; }
    else
      base="$remote_sha"
    fi
    if ! changed="$(git diff --name-only "$base" "$local_sha" 2>/dev/null)"; then
      touches_dependency_state=unknown
      break
    fi
    if printf '%s\n' "$changed" | grep -qE '(^|/)Cargo\.(lock|toml)$'; then
      touches_dependency_state=yes
      pushed_tip="$local_sha"
      break
    fi
  done
fi

# No manifest in the range means the lock cannot have changed: skip its check,
# but still run the code gate -- a source-only push still needs lint and tests.
if [ "$touches_dependency_state" = "no" ]; then
  echo "pre-push: no Cargo.lock or Cargo.toml in the pushed range; lockfile check not needed" >&2
  skip_lockfile=1
fi

# `--check` measures the working tree, so its verdict is evidence about the
# pushed commits only while the two agree on dependency state. They diverge
# exactly when it matters: any cargo command rewrites `Cargo.lock`, so a tree
# whose lock a test run already repaired passes this check while the commits
# being pushed still carry the stale one. That is how a stale lock reached
# main once and failed every `--locked` job after it.
#
# The skips above fall through to the code gate, so this whole section runs
# only when the lock still wants verifying.
if [ "$skip_lockfile" = "0" ]; then
if [ -n "$pushed_tip" ] && ! git diff --quiet "$pushed_tip" -- Cargo.lock '*Cargo.toml' 2>/dev/null; then
  cat >&2 <<MESSAGE

pre-push: the working tree's Cargo.lock or manifests differ from the revision
being pushed, so a check of this tree says nothing about that push.

  pushed revision: $pushed_tip

Commit the dependency state you verified, or check out the pushed revision and
push from there. To push anyway: SKIP_LOCKFILE_CHECK=1 git push
MESSAGE
  exit 1
fi

checker="$repo_root/scripts/lockfile.py"

python_bin="${PYTHON:-}"
if [ -z "$python_bin" ]; then
  for candidate in python3 python; do
    if command -v "$candidate" >/dev/null 2>&1; then
      python_bin="$candidate"
      break
    fi
  done
fi

if [ ! -f "$checker" ]; then
  # A guard that reports its own absence and lets the push through is the
  # absence. The code gate below would still have run, but the lock is what
  # this section is for, and an unverified lock is the failure it exists to
  # stop -- so refuse here and name the one deliberate way through.
  echo "pre-push: scripts/lockfile.py not present; lockfile not verified" >&2
  echo "pre-push: push anyway with SKIP_LOCKFILE_CHECK=1 git push" >&2
  exit 1
elif [ -z "$python_bin" ]; then
  echo "pre-push: no python interpreter found; lockfile not verified" >&2
  echo "pre-push: push anyway with SKIP_LOCKFILE_CHECK=1 git push" >&2
  exit 1
elif ! "$python_bin" "$checker" --check; then
  cat >&2 <<'MESSAGE'

pre-push: Cargo.lock does not resolve under --locked, so every CI job that
passes --locked would fail on this push.

The usual cause is a cargo command run from inside the Atlas stack, which
strips the lock's git sources. Repair it with:

    python3 scripts/lockfile.py --regenerate

then stage the result. To push anyway: SKIP_LOCKFILE_CHECK=1 git push
MESSAGE
  exit 1
fi
fi
# End of the lockfile section; the code gate below runs unconditionally.

# ---------------------------------------------------------------------------
# Fast local gate, scoped to the pushed range.
#
# The lockfile guard above is one third of what CI runs, and the other two
# thirds are where defects have actually escaped: a merge once landed two
# clippy denials that turned the architecture validation red on main and on
# every pull request that merged it, because nothing local ran clippy.
# CI should confirm, not discover.
#
# Scope is the push, not the workspace: a workspace clippy takes minutes on a
# large member, and a gate that slow is a gate people bypass. The changed files
# map to their packages and only those are linted and tested.
#
# `cargo fmt` needs no dependency resolution; clippy and nextest do, and how
# they resolve decides whether this gate is usable at all. Cargo finds the
# stack's `[patch]` overlay by walking up from the working directory, so running
# from a neutral directory with `--manifest-path` escapes it -- and with it the
# shared target directory and every first-party dependency, which then resolve
# to their git sources instead of the local trees. Nothing in the cache matches
# and the gate rebuilds the world: measured at over ten minutes for a single
# leaf crate, which is not a pre-push gate.
#
# So these run from the repository, inside the overlay, on the warm cache. The
# cost is that cargo rewrites `Cargo.lock` as it goes -- stripping the git
# sources CI needs -- which is the very corruption the guard above exists to
# catch. The lock is therefore restored byte-for-byte afterwards, whatever it
# held, so the gate cannot damage what it just verified.
#
# For the same reason nothing here passes `--locked`: under the overlay the lock
# *must* change, so `--locked` would fail on resolution before reaching a line
# of code. Lock correctness is the guard's job, checked from outside the
# overlay; this gate's job is the code.
#
# Bypass deliberately:
#
#     SKIP_LOCAL_GATE=1 git push

if [ "${SKIP_LOCAL_GATE:-0}" = "1" ]; then
  echo "pre-push: local gate skipped by SKIP_LOCAL_GATE" >&2
  exit 0
fi

if ! command -v cargo >/dev/null 2>&1; then
  # No toolchain on this machine (docs-only checkout, bare CI image without
  # Rust): say so rather than failing every push on a missing binary.
  echo "pre-push: no cargo toolchain found; local gate not run" >&2
  exit 0
fi

gate_base=""
if upstream="$(git rev-parse --verify --quiet '@{upstream}' 2>/dev/null)"; then
  gate_base="$upstream"
else
  # A branch pushed for the first time has no upstream yet; its own commits
  # are what the default branch does not have.
  gate_base="$(default_branch_base HEAD || true)"
fi

if [ -z "$gate_base" ]; then
  echo "pre-push: no upstream or remote default branch to diff against; local gate skipped" >&2
  exit 0
fi

gate_changed="$(git diff --name-only "$gate_base" HEAD 2>/dev/null || true)"

if ! printf '%s\n' "$gate_changed" | grep -qE '\.rs$|(^|/)Cargo\.toml$'; then
  echo "pre-push: no Rust source or manifest in the pushed range; local gate not needed" >&2
  exit 0
fi

# Changed paths -> the packages that own them. Ownership follows Cargo itself:
# the nearest ancestor directory holding a `[package]` manifest owns the file.
# That covers `crates/<name>/` leaves, `xtask/`, top-level crates, and the
# single-crate members whose sources sit beside the root manifest alike;
# anything else (docs, workflows, the board) has no package and contributes
# nothing to lint or test.
gate_packages=""
while IFS= read -r changed_path; do
  [ -n "$changed_path" ] || continue
  owner_dir="$(dirname "$changed_path")"
  package_dir=""
  while [ "$owner_dir" != "." ] && [ "$owner_dir" != "/" ]; do
    manifest="$repo_root/$owner_dir/Cargo.toml"
    if [ -f "$manifest" ]; then
      if grep -qE '^\[package\]' "$manifest" 2>/dev/null; then
        package_dir="$owner_dir"
      fi
      break
    fi
    owner_dir="$(dirname "$owner_dir")"
  done
  if [ -z "$package_dir" ]; then
    if [ -f "$repo_root/Cargo.toml" ] && grep -qE '^\[package\]' "$repo_root/Cargo.toml" 2>/dev/null; then
      package_dir="."
    else
      continue
    fi
  fi
  manifest="$repo_root/$package_dir/Cargo.toml"
  package_name="$(sed -n 's/^name[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$manifest" | head -1)"
  [ -n "$package_name" ] || continue
  case " $gate_packages " in
    *" $package_name "*) ;;
    *) gate_packages="$gate_packages $package_name" ;;
  esac
done <<GATE_PATHS
$gate_changed
GATE_PATHS

if [ -z "${gate_packages// /}" ]; then
  echo "pre-push: no package owns the changed files; local gate not needed" >&2
  exit 0
fi

# Run one gate step and say whose failure it was.
#
# The step runs inside the stack overlay, so its dependency graph is the local
# working trees rather than the git sources CI resolves. When that graph is
# broken -- a member whose version requirement lags its provider's, so the
# overlay cannot patch it and one crate resolves to git while its dependencies
# resolve local -- the step fails on a crate under `~/.cargo`, nowhere near the
# push. Reporting that as "your clippy fails" is how a gate loses its
# credibility and starts getting bypassed.
#
# The verdict defaults to 'ours' and only an affirmative case moves it. A
# failing test emits no compile diagnostics at all, so "found nothing outside
# the repository" must not be read as "the environment did it" -- that reading
# passed a deliberately failing test during probing, which is the exact defect
# this gate exists to prevent. Blame the change unless the evidence positively
# says otherwise.
#
# Echoes 'ours', 'environment', or 'ok'.
normalise_diagnostic_path() {
  local value="$1"
  value="$(printf '%s' "$value" | tr 'A-Z\' 'a-z/' 2>/dev/null)"

  # Git Bash can expose the repository through its long path while cargo's
  # diagnostics use an equivalent DOS 8.3 path (for example, RYANCL~1). Use
  # one Windows spelling for both sides when cygpath is available; POSIX
  # runners retain the normalized slash form above.
  if command -v cygpath >/dev/null 2>&1; then
    case "$value" in
      [a-z]:/*|/*)
        local short_value
        if short_value="$(cygpath -m -s "$value" 2>/dev/null)"; then
          # cygpath spells the drive letter upper case; the classifier's
          # drive-path case is lower case, as the first pass left it.
          value="$(printf '%s' "$short_value" | tr 'A-Z' 'a-z')"
        fi
        ;;
    esac
  fi
  printf '%s' "$value"
}

classify_gate_step() {
  local log="$1"
  shift
  if (cd "$repo_root" && "$@" >"$log" 2>&1); then
    echo ok
    return 0
  fi

  local root_normalised inside=0 outside=0 location foreign_crate=0
  root_normalised="$(normalise_diagnostic_path "$repo_root")"

  # Only locations under an `error` header count. A crate that fails to compile
  # still emits warnings for whatever did compile, and counting those made the
  # verdict depend on what the build cache happened to hold.
  #
  # Deduplication is awk, not `sort -u`: on Windows developer machines `sort`
  # can resolve to the System32 SORT.EXE, which rejects `-u` and empties the
  # pipeline -- every verdict then degrades to 'ours'.
  while IFS= read -r location; do
    [ -n "$location" ] || continue
    location="$(normalise_diagnostic_path "$location")"
    case "$location" in
      /*|[a-z]:/*)
        case "$location" in
          "$root_normalised"/*) inside=$((inside + 1)) ;;
          *) outside=$((outside + 1)) ;;
        esac
        ;;
      *) inside=$((inside + 1)) ;;
    esac
  done <<DIAGNOSTICS
$(awk '/^error/ { under_error = 1; next } /^warning/ { under_error = 0; next } under_error && /^[[:space:]]*--> / { sub(/^[[:space:]]*--> /, ""); sub(/:[0-9]+:[0-9]+$/, ""); if (!seen[$0]++) print }' "$log")
DIAGNOSTICS

  # A cached rebuild can report `could not compile` without re-emitting the
  # diagnostic that explains it, so the failing crate's name is a second
  # witness: one that is not being gated is not this push's.
  local failed_crate
  while IFS= read -r failed_crate; do
    [ -n "$failed_crate" ] || continue
    case " $gate_packages " in
      *" $failed_crate "*) ;;
      *) foreign_crate=$((foreign_crate + 1)) ;;
    esac
  done <<CRATES
$(sed -n 's/^error: could not compile `\([^`]*\)`.*/\1/p' "$log" | awk '!seen[$0]++')
CRATES

  if [ "$inside" -eq 0 ] && { [ "$outside" -gt 0 ] || [ "$foreign_crate" -gt 0 ]; }; then
    echo environment
  else
    echo ours
  fi
}

report_broken_graph() {
  local step="$1" log="$2"
  cat >&2 <<MESSAGE

pre-push: the $step step failed, but every diagnostic points outside this
repository, so the local dependency graph is broken rather than this change.
That is usually the stack overlay: a member whose requirement lags its
provider stays git-sourced while its dependencies resolve locally, and the
halves disagree.

The gate could not run, so this push is NOT verified. First diagnostic:

MESSAGE
  grep -m 1 -A 3 -E '^error' "$log" >&2 || true
  cat >&2 <<'MESSAGE'

Check with `python scripts/atlas-stack-overlay.py check` at the stack root.
MESSAGE
}

gate_specs=""
for package_name in $gate_packages; do
  gate_specs="$gate_specs -p $package_name"
done

echo "pre-push: gating${gate_packages}" >&2

# Restore whatever the lock held before this gate ran -- the committed content,
# or a developer's own uncommitted edit to it. Copying the bytes rather than
# checking out the committed file is what makes the second case safe: this hook
# must not decide that someone's in-progress lock work was a side effect of its
# own.
gate_lock="$repo_root/Cargo.lock"
gate_lock_backup=""
if [ -f "$gate_lock" ]; then
  gate_lock_backup="$(mktemp)"
  cp -p "$gate_lock" "$gate_lock_backup"
fi

restore_gate_lock() {
  if [ -n "$gate_lock_backup" ] && [ -f "$gate_lock_backup" ]; then
    if ! cmp -s "$gate_lock_backup" "$gate_lock" 2>/dev/null; then
      cp -p "$gate_lock_backup" "$gate_lock" || true
    fi
    rm -f "$gate_lock_backup" || true
  fi
  rm -f "$gate_log" 2>/dev/null || true
}

trap restore_gate_lock EXIT INT TERM

# Formatting is workspace-wide and near-instant, and its failure is the
# cheapest one to find here rather than on a runner.
if ! (cd "$repo_root" && cargo fmt -- --check >/dev/null); then
  cat >&2 <<'MESSAGE'

pre-push: `cargo fmt --check` fails, so the architecture validation would.

Run `cargo fmt` and stage the result. To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
  exit 1
fi

# The workspace lint table denies what matters, so this gate runs clippy
# without extra flags: adding `-D warnings` here would fail on the
# pre-existing per-crate debt the ratchet exists to burn down, and a gate
# that fails on debt you did not write is a gate that gets bypassed.
gate_log="$(mktemp)"
trap 'rm -f "$gate_log"; restore_gate_lock' EXIT INT TERM

case "$(classify_gate_step "$gate_log" cargo clippy $gate_specs --all-targets)" in
  ours)
    cat >&2 <<MESSAGE

pre-push: clippy fails for$gate_packages, so the CI ratchet would.

Reproduce:

    cargo clippy$gate_specs --all-targets

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
    exit 1
    ;;
  environment)
    report_broken_graph clippy "$gate_log"
    exit 0
    ;;
esac

if command -v cargo-nextest >/dev/null 2>&1; then
  case "$(classify_gate_step "$gate_log" cargo nextest run $gate_specs)" in
    ours)
      cat >&2 <<MESSAGE

pre-push: tests fail for$gate_packages.

Reproduce:

    cargo nextest run$gate_specs

To push anyway: SKIP_LOCAL_GATE=1 git push
MESSAGE
      exit 1
      ;;
    environment)
      report_broken_graph test "$gate_log"
      exit 0
      ;;
  esac
else
  echo "pre-push: cargo-nextest not installed; tests not run" >&2
fi

echo "pre-push: local gate passed" >&2
